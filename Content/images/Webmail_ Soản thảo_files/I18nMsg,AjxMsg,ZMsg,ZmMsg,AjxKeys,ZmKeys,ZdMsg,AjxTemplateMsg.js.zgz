a["voice.UNABLE_TO_RETRIEVE_PROFILE_SUMMARY"]="H\u1ec7 th\u1ed1ng hi\u1ec7n th\u1eddi kh\u00f4ng th\u1ec3 ho\u00e0n th\u00e0nh y\u00eau c\u1ea7u. Ch\u00fang t\u00f4i l\u1ea5y l\u00e0m ti\u1ebfc v\u1ec1 s\u1ef1 phi\u1ec1n ph\u1ee9c n\u00e0y.";
a["voice.UNABLE_TO_RETRIEVE_CALLLOGS"]="Ch\u00fang t\u00f4i hi\u1ec7n th\u1eddi kh\u00f4ng th\u1ec3 hi\u1ec3n th\u1ecb b\u1ea3n ghi cu\u1ed9c g\u1ecdi. Ch\u00fang t\u00f4i l\u1ea5y l\u00e0m ti\u1ebfc v\u1ec1 s\u1ef1 phi\u1ec1n ph\u1ee9c n\u00e0y.";
a["voice.UNABLE_TO_RETRIEVE_VOICEMAIL_FOLDER"]="Chung t\u00f4i t\u1ea1m th\u1eddi kh\u00f4ng th\u1ec3 hi\u1ec3n th\u1ecb c\u00e1c b\u1ea3n ghi th\u01b0 tho\u1ea1i.";
a["voice.UNABLE_TO_UPDATE_CALL_FEATURES"]="Ch\u00fang t\u00f4i t\u1ea1m th\u1eddi kh\u00f4ng th\u1ec3 chuy\u1ec3n ti\u1ebfp c\u00e1c cu\u1ed9c g\u1ecdi. Ch\u00fang t\u00f4i l\u1ea5y l\u00e0m ti\u1ebfc v\u1ec1 s\u1ef1 phi\u1ec1n ph\u1ee9c n\u00e0y.";
a["voice.UNABLE_TO_MODIFY_CALL_FEATURES"]="Ch\u00fang t\u00f4i t\u1ea1m th\u1eddi kh\u00f4ng th\u1ec3 chuy\u1ec3n ti\u1ebfp c\u00e1c cu\u1ed9c g\u1ecdi. Ch\u00fang t\u00f4i l\u1ea5y l\u00e0m ti\u1ebfc v\u1ec1 s\u1ef1 phi\u1ec1n ph\u1ee9c n\u00e0y.";
a["voice.UNABLE_TO_MODIFY_VOICEMAIL_PREFS"]="M\u1ed9t l\u1ed7i \u0111\u00e3 xay ra trong khi c\u1ed1 g\u1eafng c\u1eadp nh\u1eadt tham chi\u1ebfu th\u01b0 tho\u1ea1i c\u1ee7a b\u1ea1n. H\u00e3y th\u1eed l\u1ea1i.";
a["voice.UNABLE_TO_FORWARD_VOICEMAIL"]="Mail c\u1ee7a b\u1ea1n kh\u00f4ng th\u1ec3 \u0111\u01b0\u1ee3c chuy\u1ec3n ti\u1ebfp trong th\u1eddi \u0111i\u1ec3m hi\u1ec7n t\u1ea1i. H\u00e3y th\u1eed l\u1ea1i sau.";
a["voice.UNABLE_TO_RETRIEVE_CALL_FEATURES"]="Kh\u00f4ng th\u1ec3 c\u00e1c nh\u1eadn \u0111\u1eb7c \u0111i\u1ec3m cu\u1ed9c g\u1ecdi.";
a["voice.UNABLE_TO_RETRIEVE_VOICEMAIL_CONTENT"]="Kh\u00f4ng th\u1ec3 nh\u1eadn n\u1ed9i dung th\u01b0 tho\u1ea1i.";
a["voice.UNABLE_TO_RETRIEVE_VOICEMAIL_PREFS"]="Kh\u00f4ng th\u1ec3 nh\u1eadn tham chi\u1ebfu th\u01b0 tho\u1ea1i.";
a["voice.UNABLE_TO_RETRIEVE_VOICEMAIL_SUMMARY"]="Kh\u00f4ng th\u1ec3 nh\u1eadn b\u1ea3n t\u00f3m t\u1eaft c\u1ee7a th\u01b0 tho\u1ea1i.";
a["voice.UNABLE_TO_MODIFY_VOICEMAIL_STATUS"]="Kh\u00f4ng th\u1ec3 thay \u0111\u1ed5i tr\u1ea1ng th\u00e1i th\u01b0 tho\u1ea1i.";
a["voice.UNABLE_TO_EMPTY_VOICEMAIL_TRASH"]="Kh\u00f4ng th\u1ec3 l\u00e0m tr\u1ed1ng th\u00f9ng r\u00e1c th\u01b0 tho\u1ea1i.";
