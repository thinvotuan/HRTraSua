a.ASST_CONTACT_HELP="Tr\u00ecnh tr\u1ee3 l\u00fd li\u00ean h\u1ec7 cho ph\u00e9p b\u1ea1n t\u1ea1o nhanh m\u1ed9t li\u00ean h\u1ec7 m\u1edbi m\u00e0 kh\u00f4ng c\u1ea7n chuy\u1ec3n ng\u1eef c\u1ea3nh t\u1eeb c\u00e1i m\u00e0 b\u1ea1n \u0111ang l\u00e0m hi\u1ec7n th\u1eddi.<br><br><b>V\u00ed d\u1ee5:</b><br><ul><li>John Doe john@doe.com www.doe.com (123) 456-6789<li>l:Doe f:John e:john@doe.com hu: http://www.doe.com hf: (123) 456-6789<li>c:zimbra [1500 fashion island blvd; san mateo; ca; 94404]</ul><br><b>C\u00e1c tr\u01b0\u1eddng c\u00f3 s\u1eb5n:</b><br><br>";
a.ASST_APPT_HELP="Tr\u00ecnh tr\u1ee3 l\u00fd cu\u1ed9c h\u1eb9n cho ph\u00e9p b\u1ea1n t\u1ea1o nhanh m\u1ed9t cu\u1ed9c h\u1eb9n m\u00e0 kh\u00f4ng c\u1ea7n chuy\u1ec3n ng\u1eef c\u1ea3nh t\u1eeb c\u00e1i m\u00e0 b\u1ea1n \u0111ang l\u00e0m hi\u1ec7n th\u1eddi.<br><br><b>V\u00ed d\u1ee5:</b><br><ul><li>\u0103n tr\u01b0a v\u1edbi Dave v\u00e0o Th\u1ee9 S\u00e1u t\u1edbi, l\u00fac 11am - 1pm<li>\"H\u1ed9i Th\u1ea3o Linux\" t\u1eeb 05-10 Th\u00e1ng 4 [H\u00e0 N\u1ed9i]</ul>";
a.ASST_CALENDAR_HELP="Tr\u00ecnh tr\u1ee3 l\u00fd l\u1ecbch cho ph\u00e9p b\u1ea1n chuy\u1ec3n t\u1edbi nhanh m\u1ed9t ng\u00e0y c\u1ee5 th\u1ec3 v\u00e0 khung nh\u00ecn l\u1ecbch.<br><br><b>V\u00ed d\u1ee5:</b><br><ul><li>8 - Th\u00e1ng 8<li>Th\u1ee9 S\u00e1u t\u1edbi<li>Th\u00e1ng 12 December<li>5 - Th\u00e1ng 1 N\u0103m 2008</ul>";
a.ASST_MAIL_HELP="Tr\u00ecnh tr\u1ee3 l\u00fd th\u01b0 cho ph\u00e9p b\u1ea1n g\u1eedi nhanh m\u1ed9t th\u00f4ng \u0111i\u1ec7p th\u01b0 m\u1edbi m\u00e0 kh\u00f4ng c\u1ea7n chuy\u1ec3n ng\u1eef c\u1ea3nh t\u1eeb c\u00e1i m\u00e0 b\u1ea1n \u0111ang l\u00e0m hi\u1ec7n th\u1eddi.<br><br><b>V\u00ed d\u1ee5:</b><br><ul><li>\"call me\" to:john@doe.com body: call me about the quote<li>subject: monday is good to:john@doe.com cc:jan@doe.com</ul>";
a.ASST_TASK_HELP="Tr\u00ecnh tr\u1ee3 l\u00fd T\u00c1C V\u1ee4 cho ph\u00e9p b\u1ea1n t\u1ea1o nhanh m\u1ed9t T\u00c1C V\u1ee4 m\u1edbi m\u00e0 kh\u00f4ng c\u1ea7n chuy\u1ec3n \u0111\u1ed5i ng\u1eef c\u1ea3nh t\u1eeb c\u00e1i m\u00e0 b\u1ea1n \u0111ang l\u00e0m hi\u1ec7n th\u1eddi.<br><br><b>V\u00ed d\u1ee5:</b><br><ul><li>\u0103n tr\u01b0a v\u1edbi Dave v\u00e0o Th\u1ee9 S\u00e1u t\u1edbi <li>\"Luy\u1ec7n t\u1eadp b\u00f3ng \u0111\u00e1\" t\u1eeb 05-10 Th\u00e1ng 4 [H\u00e0 n\u1ed9i]</ul>";
