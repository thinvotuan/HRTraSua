a.acceptShareDetailsAdmin="<li>B\u1ea1n c\u00f3 th\u1ec3 <b>Xem</b> v\u00e0 <b>S\u1eeda</b> m\u1ee5c trong th\u01b0 m\u1ee5c n\u00e0y.<li>B\u1ea1n c\u00f3 th\u1ec3 <b>Th\u00eam</b> v\u00e0 <b>X\u00f3a</b> m\u1ee5c trong th\u01b0 m\u1ee5c n\u00e0y.<li>B\u1ea1n c\u00f3 th\u1ec3 <b>Ch\u1ea5p nh\u1eadn</b> v\u00e0 <b>T\u1eeb ch\u1ed1i</b> t\u00e1c v\u1ee5 lu\u1ed3ng trong th\u01b0 m\u1ee5c n\u00e0y.<li>B\u1ea1n c\u00f3 th\u1ec3 <b>Qu\u1ea3n l\u00fd</b> th\u01b0 m\u1ee5c nh\u01b0 n\u00f3 l\u00e0 s\u1edf h\u1eefu c\u1ee7a b\u1ea1n (vd: chia s\u1ebb v\u1edbi ng\u01b0\u1eddi d\u00f9ng kh\u00e1c).";
a.acceptShareDetailsManager="<li>B\u1ea1n c\u00f3 th\u1ec3 <b>Xem</b> v\u00e0 <b>S\u1eeda</b> c\u00e1c m\u1ee5c trong th\u01b0 m\u1ee5c.<li>B\u1ea1n c\u00f3 th\u1ec3 <b>Th\u00eam</b> v\u00e0 <b>Lo\u1ea1i b\u1ecf</b> c\u00e1c m\u1ee5c t\u1eeb/t\u1edbi th\u01b0 m\u1ee5c.<li>B\u1ea1n c\u00f3 th\u1ec3 <b>\u0110\u1ed3ng \u00fd</b> v\u00e0 <b>T\u1eeb ch\u1ed1i</b> c\u00e1c h\u00e0nh \u0111\u1ed9ng workflow trong th\u01b0 m\u1ee5c.";
