this._mainContainer=document.getElementById("z_shell").appendChild(document.createElement("div"));
this._mainContainer.style.left="100px";
this._mainContainer.style.top="200px";
this._mainContainer.style.position="absolute";
this._mainContainer.style.display="block";
this._mainContainer.style.zIndex=9000;
var t=new Array();
var e=0;
t.push("<DIV id ='stickyn_actionContainerID' class='stickyn_axnClass'>","<table width='100%'><tr><td width='85%'></td><td width='5%'>","<img  style='cursor:pointer;' src=\"",this.getResource("sticky_deleteBtn.png"),"\" id='stickyn_deleteBtn' /></td>","<td width='5%'></td><td width='5%'><img  style='cursor:pointer;' src=\"",this.getResource("sticky_saveBtn.png"),"\" id='stickyn_closeBtn'/></td></tr>","</table></DIV>","<TEXTAREA  id ='stickyn_textAreaID'class='stickyn_textAreaClass'>","</TEXTAREA>");
this._mainContainer.innerHTML=t.join("");
