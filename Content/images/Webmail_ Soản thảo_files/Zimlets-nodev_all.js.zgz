document.getElementById("stickyn_deleteBtn").onclick=AjxCallback.simpleClosure(this._deleteSaveAndHideStickyNotes,this)
};
StickyNotesZimlet.prototype.initializeToolbar=function(r,s,o,t){
t=appCtxt.getViewTypeFromId(t);
if(t==ZmId.VIEW_CONVLIST||t==ZmId.VIEW_CONV||t==ZmId.VIEW_TRAD||t=="CNS"||t=="CLD"){
ZmMsg.stickyNotesLabel=this.getMessage("sn_label");
ZmMsg.stickyNotesTip=this.getMessage("sn_tooltip");
var e={
text:ZmMsg.stickyNotesLabel,tooltip:ZmMsg.stickyNotesTip,image:"stickynotes-panelIcon",showImageInToolbar:true,showTextInToolbar:false};
if(!s.getOp(StickyNotesZimlet.stickyNotes)){
var n=s.createZimletOp(StickyNotesZimlet.stickyNotes,e);
n.addSelectionListener(new AjxListener(this,this._stickyTBListener,[o]))
}}};
StickyNotesZimlet.prototype._stickyTBListener=function(e){
try{
var o=e.getCurrentView().getSelection()
}
catch(t){
try{
var o=e.getCurrentView().getListView().getSelection()
}
catch(t){}}
if(o.length>0){
if(o[0].isDL!==true){
this.srcMsgObj=o[0];
if(this.srcMsgObj.type=="CONV"){
this.srcMsgObj=this.srcMsgObj.getFirstHotMsg()
}
this._createStickyNotes(this.srcMsgObj)
}}};
StickyNotesZimlet.prototype._createStickyNotes=function(e){
if(e.type=="CONV"){
this._itemId=e.cid
}else{
if(e.type=="MSG"||e.type=="CONTACT"||e.type=="APPT"){
this._itemId=e.id
}else{
return
}}
this._showStickyNotes(true,"")
};
StickyNotesZimlet.prototype.onMsgView=function(e){
if(this.stickyNotesDisplayed){
this._hideStickyNotes()
}
this.srcMsgObj=e;
if(this.srcMsgObj.tags.length==0){
return
}
if(e.type=="CONV"){
this._itemId=e.cid
}else{
if(e.type=="MSG"){
this._itemId=e.id
}}
this._handleItemSelect()
};
StickyNotesZimlet.prototype._onContactOrApptView=function(e){
try{
var o=e.getCurrentView().getSelection()
}
catch(t){
var o=e.getCurrentView().getListView().getSelection()
}
if(o.length>0){
this.srcMsgObj=o[0];
this._itemId=this.srcMsgObj.id
}
this._handleItemSelect()
};
StickyNotesZimlet.prototype._handleItemSelect=function(){
this._getStickyNotesMetaData(this._itemId,new AjxCallback(this,this._showStickyNotes,false))
};
StickyNotesZimlet.prototype._showErrorMessage=function(o){
var t="";
if(o instanceof AjxException){
t=o.msg
}else{
t=o
}
var e=appCtxt.getMsgDialog();
e.reset();
e.setMessage(t,DwtMessageDialog.WARNING_STYLE);
e.popup()
};
StickyNotesZimlet.prototype._migrateOldData=function(){
var t=this.getUserProperty("stickyNotes_data");
if(t==""){
return
}
var n=t.split(":=:");
this._msgIdAndDataArry=[];
for(var e=0;
e<n.length;
e++){
if(n[e]==""){
continue
}
var r=n[e].split(",__data::");
var s=r[0].replace("__id::","").replace("MSG","").replace("CONV","");
var o=r[1];
this._saveStickyNotesDataToServer(s,o)
}
this.setUserProperty("stickyNotes_data","",true)
};