<?xml version="1.0" encoding="utf-8"?><Database Name="NhanSuService" Class="NSServiceDataContext" xmlns="http://schemas.microsoft.com/linqtosql/dbml/2007">
  <Table Name="dbo.Sys_ThongBao" Member="Sys_ThongBaos">
