        $(".diem").bind("keyup", function () {

            if ($(this).val() > 10)
                $(this).val(10);
            var maNV = $(this).attr("alt").trim();
            var tong1 = getNumber($("#" + maNV + "_xepLoai_1").val()) * 1;
            var tong2 = getNumber($("#" + maNV + "_xepLoai_2").val()) * 2;
            var tong3 = getNumber($("#" + maNV + "_xepLoai_3").val()) * 2;
            var tong4 = getNumber($("#" + maNV + "_xepLoai_4").val()) * 1.5;
            var tong5 = getNumber($("#" + maNV + "_xepLoai_5").val()) * 1;
            var tong6 = getNumber($("#" + maNV + "_xepLoai_6").val()) * 3;
            var tong7 = getNumber($("#" + maNV + "_xepLoai_7").val()) * 1.5;
            var tongDiem = 0;
            var heSo = 0;
            if (tong1 > 0) {
                heSo += 1;
                tongDiem += tong1;
            }
            if (tong2 > 0) {
                heSo += 2;
                tongDiem += tong2;
            }
            if (tong3 > 0) {
                heSo += 2;
                tongDiem += tong3;
            }
            if (tong4 > 0) {
                heSo += 1.5;
                tongDiem += tong4;
            }
            if (tong5 > 0) {
                heSo += 1;
                tongDiem += tong5;
            }
            if (tong6 > 0) {
                heSo += 3;
                tongDiem += tong6;
            }
            if (tong7 > 0) {
                heSo += 1.5;
                tongDiem += tong7;
            }

            if (tongDiem == 0) {
                $("#" + maNV + "_diemTong").val(0);
            }
            else {
                $("#" + maNV + "_diemTong").val(parseFloat(tongDiem / heSo).toFixed(2));
            }
        });
        // Update when change 
        $(".diem").bind("change", function () {
            if ($(this).val() > 10)
                $(this).val(10);
            var maNV = $(this).attr("alt").trim();
            var TenNV = $(this).attr("altHoTen").trim();
            var tong1 = getNumber($("#" + maNV + "_xepLoai_1").val());
            var tong2 = getNumber($("#" + maNV + "_xepLoai_2").val());
            var tong3 = getNumber($("#" + maNV + "_xepLoai_3").val());
            var tong4 = getNumber($("#" + maNV + "_xepLoai_4").val());
            var tong5 = getNumber($("#" + maNV + "_xepLoai_5").val());
            var tong6 = getNumber($("#" + maNV + "_xepLoai_6").val());
            var tong7 = getNumber($("#" + maNV + "_xepLoai_7").val());
            var tongDiem = getNumber($("#" + maNV + "_diemTong").val()).toFixed(2);
            var url = '@Url.Action("CapNhatDiemNVDanhGia", "DanhGiaTinNhiem")';
            $.ajax({
                type: "POST",
                url: url,
                data: {
                    maNhanVien: maNV,
                    tong1: tong1,
                    tong2: tong2,
                    tong3: tong3,
                    tong4: tong4,
                    tong5: tong5,
                    tong6: tong6,
                    tong7: tong7,
                    tongDiem: tongDiem
                },
                success: function (result) {

                    if (result == "true") {
                        Alert.success("Đã cập nhật đánh giá nhân viên: " + TenNV, "Thông báo", { displayDuration: 4000 });

                    }
                    else {
                        Alert.success("Có lỗi xãy ra trong quá trình xử lý.", "Thông báo", { displayDuration: 4000 });
                        location.reload();
                    }
                }
            });
        });
        // cap nhat nhan xet
        $(".txtNhanXet").bind("change", function () {
            var txtNhanXet = $(this).val();
            var maNhanVien = $(this).parent().attr("attrNV");
            var TenNV = $(this).parent().attr("altHoTen");

            var url = '@Url.Action("CapNhatNhanXetNVDanhGia", "DanhGiaTinNhiem")';
            $.ajax({
                type: "POST",
                url: url,
                data: {
                    maNhanVien: maNhanVien,
                    txtNhanXet: txtNhanXet
                },
                success: function (result) {

                    if (result == "true") {
                        Alert.success("Đã cập nhật nhận xét nhân viên: " + TenNV, "Thông báo", { displayDuration: 4000 });

                    }
                    else {
                        Alert.success("Có lỗi xãy ra trong quá trình xử lý.", "Thông báo", { displayDuration: 4000 });
                        location.reload();
                    }
                },
                error: function (result) {
                    Alert.success("Có lỗi xãy ra trong quá trình xử lý.", "Thông báo", { displayDuration: 4000 });
                    location.reload();
                }
            });
        });
    });

    function checkForm() {
        var flag = true;
        //            if (isEmpty($("#Name"), ""))
        //                flag = false;
        return flag;
    }

    function ValidateKeypress(numcheck, e) {
        var keynum, keychar, numcheck;
        if (window.event) {//IE
            keynum = e.keyCode;
        }
        else if (e.which) {// Netscape/Firefox/Opera
            keynum = e.which;
        }
        if (keynum == 8 || keynum == 127 || keynum == null || keynum == 9 || keynum == 0 || keynum == 13) return true;
        keychar = String.fromCharCode(keynum);
        var result = numcheck.test(keychar);
        return result;
    }
    function moveScroll() {
        var scroll = $(window).scrollTop();
        var header_top = $("header").height();

        var anchor_top = $("#gridSource").offset().top;
        var anchor_bottom = $("#bottom_anchor").offset().top;
        if (scroll > anchor_top && scroll < anchor_bottom) {
            clone_table = $("#clone");
            if (clone_table.length == 0) {
                clone_table = $("#gridSource").clone();
                clone_table.attr('id', 'clone');
                clone_table.css({
                    position: 'fixed',
                    'pointer-events': 'none',
                    top: 0,

                });
                clone_table.width($("#gridSource").width());
                $("#table-container").append(clone_table);
                $("#clone").css({ visibility: 'hidden' });
                $("#clone thead").css({ visibility: 'visible' });
            }
        } else {
            $("#clone").remove();
        }
    }
    $(window).scroll(moveScroll);


    function HoanThanhDanhGia() {
        bootbox.confirm("Khi xác nhận đều này, phiếu đánh giá của bạn sẽ không được hiệu chỉnh.\nBạn có chắc chắn hoàn thành đánh giá này không?", function (result) {
            if (result) {

                $("#Loadding,.heThongDangXuLy").show(); $(".ShowFinish").hide();
                $.ajax({
                    type: "POST",
                    url: "/DanhGiaTinNhiem/HoanThanhDanhGia",
                    data: {

                    },

                    success: function (result) {
                        if (result == "true") {
                            bootbox.alert("Cảm ơn bạn đã tham gia đánh giá!", function () {
                                var Url = '@Url.Action("ThongBao/", "DanhGiaTinNhiem")';
                                location.href = Url;
                            });
                        }
                        else {
                            Alert.error("Có lỗi xãy ra trong quá trình xử lý.", "Thông báo", { displayDuration: 2000 });
                            location.reload();

                        }
                    },
                    error: function (result) {

                        Alert.error("Có lỗi xãy ra trong quá trình xử lý.", "Thông báo", { displayDuration: 2000 });
                        location.reload();
                    }
                });

            }
        });
    }
</script>

