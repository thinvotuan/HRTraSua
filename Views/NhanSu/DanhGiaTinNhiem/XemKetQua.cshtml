@using BatDongSan.Models.NhanSu

@{
    ViewBag.Title = "Index";
    //AcTionResult ==1 Xem ket qua
    if (ViewBag.AcTionResult == 1)
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
    else
    {

        Layout = "~/Views/Shared/_Popup.cshtml";
    }
   
}
@{
    var thongTin = ViewData["ThongTinNhanVien"] as vw_NS_DanhSachNhanVienTheoPhongBan;
    var listNhanVien = ViewData["ListNhanVien"] as List<sp_NS_KetQuaDanhGiaNhanVien_ChiTietResult>;
    <div class="wrapper_danhgia_home " id="container" style="margin: 0px auto;">
        <div>
            <div style="margin-top: 10px;">
                <div class="titleBorderPhieu">
                    <div class="colorCommonBieuNgu">
                        Báo cáo chi tiết kết quả đánh giá nhân viên<br>
                        <span>Trách Nhiệm</span> – <span>Công Tâm</span> – <span>Đúng Sự Thật</span>
                    </div>
                </div>

                <table style="width: 100%" class="table table-striped table-hover table-condensed tableThemeCustome">
                    <tr class="background_tr">
                        <td style="font-weight: bold;">Mã nhân viên
                        </td>
                        <td>
                            @(thongTin != null ? thongTin.maNhanVien : string.Empty)
                        </td>
                        <td style="font-weight: bold;">Họ và tên
                        </td>
                        <td>
                            @(thongTin != null ? thongTin.ho + " " + thongTin.ten : string.Empty)
                        </td>
                    </tr>
                    <tr class="background_tr">
                        <td style="font-weight: bold;">Phòng ban
                        </td>
                        <td>
                            @(thongTin != null ? thongTin.tenPhongBan : string.Empty)
                        </td>
                        <td style="font-weight: bold;">Chức vụ
                        </td>
                        <td>
                            @(thongTin != null ? thongTin.TenChucDanh : string.Empty)
                        </td>
                    </tr>
                </table>

                <table style="width: 100%;" class="table table-striped table-hover table-condensed tableThemeCustome">
                    <thead>
                        <tr class="background_tr">
                            <th style="width: 150px">Phiếu
                            </th>
                            @{
                                List<tbl_NS_TieuChi> lsTieuChi = ViewData["lsDanhMucTieuChi"] as List<tbl_NS_TieuChi>;
                                foreach (var tc in lsTieuChi)
                                {
                            
                                <th style="text-transform: none;">
                                    <b>
                                        @tc.tenTieuChi
                                    </b>
                                    <br />
                                    <p style="margin: 0px;">
                                        (Hệ số :
                                    @tc.heSoDiem )
                                    </p>
                                    @Html.Hidden("maTieuChi", tc.id)
                                </th>
                                }
                            }

                            <th style="">Tổng Điểm
                            </th>


                        </tr>
                    </thead>
                    <tbody>
                        @{
                            if (listNhanVien != null && listNhanVien.Count > 0)
                            {
                                var groupKyDanhGia = listNhanVien.Select(d => d.KyDanhGia).OrderBy(t => t).Distinct();
                                foreach (var itemKY in groupKyDanhGia)
                                {
                                    // List danh gia theo ky
                            <tr>
                                <td colspan="10">
                                    <div class="form-group bs-callout bs-callout-info" style="overflow: hidden; margin-bottom: 1px;">
                                        <h4 class="col-md-12 tieudeGroup" style="color: #1b809e; margin: 0px;">Kết quả đánh giá kỳ: @itemKY</h4>
                                    </div>
                                </td>
                            </tr>
                        
                                
                            
                                    var count = 0;
                                    var rowspan = 1;
                                    foreach (var item in listNhanVien.Where(d => d.KyDanhGia == itemKY))
                                    {
                                        count++;
                                        rowspan = 1;
                                        if (item.nhanXet != "") { rowspan = 2; }
                            
                            <tr>

                                <td rowspan="@rowspan" style="color: #04828f">Phiếu: @count
                                </td>
                                <td align="center">
                                    @string.Format("{0:#,0.##}", item.diemTC1)
                                </td>
                                <td align="center">
                                    @string.Format("{0:#,0.##}", item.diemTC2)
                                </td>
                                <td align="center">
                                    @string.Format("{0:#,0.##}", item.diemTC3)
                                </td>
                                <td align="center">
                                    @string.Format("{0:#,0.##}", item.diemTC4)
                                </td>
                                <td align="center">
                                    @string.Format("{0:#,0.##}", item.diemTC5)
                                </td>
                                <td align="center">
                                    @string.Format("{0:#,0.##}", item.diemTC6)
                                </td>
                                <td align="center">
                                    @string.Format("{0:#,0.##}", item.diemTC7)
                                </td>
                                <td align="center" style="color: Red; font-weight: bold">
                                    @string.Format("{0:#,0.##}", item.tongDiem)
                                </td>


                            </tr>
                                        if (item.nhanXet != "")
                                        {
                            <tr>
                                <td colspan="8">
                                    @item.nhanXet
                                </td>
                            </tr>
                                        }


                                    }
                                }
                            }
    // 
                                 
                        }




                    </tbody>
                </table>




            </div>
        </div>
    </div>
}