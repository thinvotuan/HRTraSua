@model IPagedList<BatDongSan.Models.DanhMuc.tbl_DM_PhuongPhapNhomDanhGia_Con>
@{
    Layout = "~/Views/Shared/_popup.cshtml";
    int i = 1;
   var datas= ViewBag.ListPPNHomDG as List<BatDongSan.Models.DanhMuc.tbl_DM_PhuongPhapNhomDanhGia_Con>;
}

<style>
    td
    {
        border: none;
    }
</style>
<script type="text/javascript">
    var obj = window.opener;
    $(document).ready(function () {
        $(".btnChonPP").click(function () {

            var valPP = $(this).val();
            // Call Check
           
            $.ajax({

                type: "POST",
                url: '/DanhGiaXepLoaiTheoBPCon/checkDaTaoNhomDanhGia',
                dataType: "json",
                data: {
                    nam: obj.$("#nam").val(),
                    maPPNhomDG: valPP
                },
                success: function (result) {
                    if (result == 1) {
                        Alert.error("Đã tạo, vui lòng chọn nhóm khác", "Thông báo", { displayDuration: 2000 });

                    }
                    else {
                        obj.$("#maPPNhomDG").val(valPP);
                        obj.LoadTiLeKhenThuong();
                        obj.LoadTiLeKhenThuongTheoSH();
                        obj.$(".showNam").html(obj.$("#nam").val()).show();
                        obj.$("#nam").hide();
                    }
                }

            });
            
        });

    });
    </script>

 <fieldset class="removeBorderFieldset">
       
        <div id="tabs" style="" class="ui-tabs">
                <ul class="ui-tabs-nav">
                    <li class="ui-tabs-selected ui-state-active"><a><span>Danh sách phiếu đánh giá xếp loại theo bộ phận con</span></a></li>
                </ul>
            </div>
      <div id="container">
    <table class="table table-striped table-hover table-condensed" id="maintable">
    <thead>
        <tr>
            <th style="text-align: center; width: 45px">STT</th>
            <th style="text-align: center; width: 150px">Mã PP đánh giá</th>
            <th style="text-align: center; width: 150px">Tên PP đánh giá</th>
            <th style="text-align: center; width: 200px">Ghi chú</th>
            <th style="width: 83px"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in datas)
        {                                                        
            <tr>
                <td style="text-align: center">@i</td>
                <td style="text-align: left">
                    <i class="fa fa-clipboard"></i><a style="color:blue" href="@Url.Action("Details", "PhuongPhapNhomDanhGia_Con", new { id = item.maPhuongPhapDanhGia })">@item.maPhuongPhapDanhGia</a>
                    <br />
                    <i class="fa fa-credit-card" aria-hidden="true"></i>@item.nguoiLap
                    <br />
                    <i class="fa fa-calendar" aria-hidden="true"></i>@String.Format("{0: dd/MM/yyyy}", item.ngayLap)
                </td>
                <td style="text-align: left">@item.tenPhuongPhapDanhGia</td>
             
                <td style="text-align: left">@Html.Raw(item.ghiChu)</td>
                <td style="text-align: right">
                   
                        <button class="btn btn-primary btn-xs btnChonPP" title="Chọn" value="@item.maPhuongPhapDanhGia" type="button">Chọn</button>
                    
                </td>
            </tr> 
                    i++;
        }
    </tbody>
</table>

    </div>
     </fieldset>

