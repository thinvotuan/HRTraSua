@using BatDongSan.Models.NhanSu
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listXL = ViewBag.listXLTong as List<BatDongSan.Models.DanhMuc.sp_DG_XepLoaiTongResult>;
   
}

<link rel="stylesheet" href="~/Content/batdongsan-alert.css" />
<script src="~/Scripts/batdongsan.utils.js"></script>
<script type="text/javascript" src="~/Scripts/Jquery.treeview/jquery.treeview.js"></script>
<link rel="stylesheet" href="~/Scripts/Jquery.treeview/jquery.treeview.css" />
<script src="~/Scripts/jquery.unobtrusive-ajax.min.js"></script>
<script>
    $(document).ready(function () {
        $(document).on("click", ".vtt", function () {
            var url = '/DanhGiaXepLoaiTheoBPCon/DanhSachPPNhomDanhGia';
            showPopup(url, 980, 550);
        });
        $(document).on("click", "#GetTongSoNVPB_Con", function () {
            GetTongSoNVPB_Con();
        });
        $("#btnTroVe").click(function () {
            location.href = "/DanhGiaXepLoaiTheoBPCon";
        });

        


    });
    function GetTongSoNVPB_Con() {

        //post
        $.ajax({

            type: "POST",
            url: '/DanhGiaXepLoaiTheoBPCon/GetTongSoNVPB_Con',
            dataType: "json",
            data: { maPPNhomDG: $("#maPPNhomDG").val() },
            success: function (result) {
                $("#TongSoNVCty").val(result);
                $(".showTongNV").html(result);
            }

        });
        $("input[name='tiLe']").val(0);
        $("input[name='tiLeNVToanCty']").val(0);

        //End post
    }
    
    function LoadTiLeKhenThuong() {
        var url = '@Url.Action("LoadTiLeKhenThuong", "DanhGiaXepLoaiTheoBPCon")' + "?maPPNhomDG=" + $("#maPPNhomDG").val() + "&nam=" + $("#nam").val() + "&maPhieu=" + $("#maPhieu").val();

        var imageUrl = '<div id="divMsg" align="center"><img src="@Url.Content("~/Content/Images/loading.gif") "/></div>';
        $('#box_TiLeKhenThuong_Con').html(imageUrl);
        $('#box_TiLeKhenThuong_Con').load(url, function () {
         
        });
        
    }
    function LoadTiLeKhenThuongTheoSH() {
        var url = '@Url.Action("LoadTiLeKhenThuongTheoXH", "DanhGiaXepLoaiTheoBPCon")' + "?maPPNhomDG=" + $("#maPPNhomDG").val() + "&nam=" + $("#nam").val() + "&maPhieu=" + $("#maPhieu").val();

        var imageUrl = '<div id="divMsg" align="center"><img src="@Url.Content("~/Content/Images/loading.gif") "/></div>';
        $('#box_TiLeKhenThuongTheoXH_Con').html(imageUrl);
        $('#box_TiLeKhenThuongTheoXH_Con').load(url, function () {

        });

    }



</script>
<style>
    .infor_MucLuongThuong, .infor_TiLe, .infor_tiLeKhenThuongTheoXephang, .infor_TongTiLeCty, .infor_XLBP
    {
        padding: 5px;
        background: rgb(226, 144, 72);
        border-radius: 3px;
        color: #fff;
        box-sizing: border-box;
        margin: 5px auto;
        line-height: 1.7;
    }
     input[name='tilephantram'],input[name='tiLe']{
	background: url("../../Images/percent.png") no-repeat;
	background-position: right center;
	background-color: #fff;
	padding-right: 14px !important;
	background-size: 20px;
}

</style>
<fieldset class="removeBorderFieldset">

    <div id="tabs" style="" class="ui-tabs">
        <ul class="ui-tabs-nav">
            <li class="ui-tabs-selected ui-state-active tabToggle activeColorTab tabXL"><a><span><i class="fa fa-add"></i>Thêm xếp loại theo bộ phận con</span></a></li>

        </ul>
    </div>

    <div id="container">

        <table style="width: 100%" class="table table-striped table-hover table-condensed tableThemeCustome">
            <tbody>
                <tr>
                    <td class="tdtitle">Mã phiếu</td>
                    <td>
                        <input type="text" value="@ViewBag.maPhieu" name="maPhieu" id="maPhieu" readonly="readonly" /></td>
                    <td>Năm: @Html.DropDownList("nam", ViewData["yearWorkings"] as SelectList, new { @style = "width:150px" })
                        <span class="showNam" style="display:none"></span>
                    </td>
                    <td class="tdtitle">PP Nhóm ĐG</td>
                    <td>
                        <input type="hidden" id="GetTongSoNVPB_Con" />
                        <input type="text" name="maPPNhomDG" id="maPPNhomDG" style="float: left; width: 200px;"  readonly="readonly"/>
                        <button type="button" class="btn btn-primary btn-xs vtt">
                            <span class="glyphicon glyphicon-plus"></span>
                        </button>
                    </td>
                </tr>


            </tbody>
        </table>
        <div id="box_TiLeKhenThuong_Con">

            
        </div>
        <div id="box_TiLeKhenThuongTheoXH_Con">

            
        </div>
         <div style="float:right">
            <input type="button" value="Trở về" class="btnTroVe" id="btnTroVe" />
        </div>
    </div>
</fieldset>
