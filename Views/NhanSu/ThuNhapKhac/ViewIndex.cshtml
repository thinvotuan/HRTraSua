@using BatDongSan.Models.NhanSu;
@model IPagedList<sp_NS_ThuNhapKhac_IndexResult>
@{
    int i = 1;
}
<script>
    function beginPaging(args) {
        // Animate        
        $('#content').fadeOut('fast');
    }

    function successPaging() {
        // Animate
        $('#content').fadeIn('normal');
    }

    function failurePaging() {
        alert("Không thể tải dữ liệu");
    }

</script>
@{
    BatDongSan.Models.HeThong.Sys_User user1 = new BatDongSan.Models.HeThong.Sys_User();
    if (Session["User"] != null)
    {
        user1 = (BatDongSan.Models.HeThong.Sys_User)Session["User"];
    }
}
<table class="table table-striped table-hover table-condensed" id="maintable">
    <thead>
        <tr>
            <th style="width: 35px">STT/Phiếu</th>
            <th style="width: 120px">Người lập</th>
            <th style="width: 50px">Tháng</th>
            <th style="width: 50px">Năm</th>
            <th style="width: 100px">Loại thu nhập</th>

            <th style="width: 80px">Trạng thái</th>
            <th style="width: 80px"></th>
        </tr>
    </thead>
    <tbody id="load">

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <a class="hvr-underline-from-center"  href="@Url.Action("Details", "ThuNhapKhac", new { id = item.id })" target="_blank" style="color:blue; text-decoration:none"><i class="fa fa-clipboard"></i>Phiếu: @i</a><br />
                    <a class="hvr-underline-from-center" href="@Url.Action("Details", "ThuNhapKhac", new { id = item.id })" target="_blank" style="color:blue; text-decoration:none">@item.soPhieu</a>
                </td>

                <td>
                    <i class="fa fa-user"></i>@item.nguoiLap
                    <br />
                    <i class="fa fa-calendar" aria-hidden="true"></i>@String.Format("{0: dd/MM/yyyy}", item.ngayLap)


                </td>
                <td style="text-align: center">@item.thang</td>
                <td style="text-align: center">@item.nam</td>
                <td>
                    @item.tenLoaiThuNhapKhac
                </td>

                <td style="text-align: center">
                    @if (item.maQuiTrinhDuyet == 0)
                    {
                        <span style="color: blue">Chưa xác nhận</span>
                    }
                    else
                    {
                        <span style="color: red">Đã xác nhận</span>
                    }
                </td>
                <td style="text-align: center">
                    @if (item.maNVL == user1.manv && item.maQuiTrinhDuyet == 0)
                    {
                        <a href="@Url.Action("Edit", "ThuNhapKhac", new { id = item.id })" title ="Sửa phiếu"><i class="fa fa-pencil-square-o" style="font-size: 30px; color: orange;" aria-hidden="true">| </i></a>
                        <a class="btnDelete" alt="@item.id" title ="Xoá phiếu"><i class="fa fa-trash" style="font-size: 30px; color: red; cursor: pointer;" aria-hidden="true"></i></a>
                    }
                </td>
            </tr> 
                    i++;
        }
    </tbody>
</table>
<div>
    Trang @Model.PageNumber của @Model.PageCount / @ViewBag.Count
</div>
<div>
    <ul class="pagination">
        @Html.Raw(Ajax.Pager(new AjaxOptions { UpdateTargetId = "content", OnBegin = "beginPaging", OnSuccess = "successPaging", OnFailure = "failurePaging" }, Model.PageSize, Model.PageNumber, Model.TotalItemCount, new { controller = "ThuNhapKhac", action = "ViewIndex", qSearch = ViewBag.Search, tuNgay = ViewBag.tuNgay, denNgay = ViewBag.denNgay, trangThai = ViewBag.trangThai }))
    </ul>
</div>
