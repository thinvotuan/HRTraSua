@using BatDongSan.Models.NhanSu;
@model NhanVienModel
@{
    ViewBag.Title = "Thông tin nhân viên";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int i = 1, count = 1;
    var listBangCap = ViewBag.listBangCap as List<tbl_NS_NhanVien_BangCap>;
    var hinhA = Model.maNhanVien + ".jpg";
}
<link rel="stylesheet" href="~/Content/bootstrap-datetimepicker.min.css" />
<script src="~/Scripts/moment.min.js"></script>
<script src="~/Scripts/vi.js"></script>
<script src="~/Scripts/bootstrap-datetimepicker.min.js"></script>
<script src="~/Scripts/autoNumeric.js"></script>
<script src="~/Scripts/batdongsan.uploadfile.js"></script>



<fieldset class="removeBorderFieldset">
    <div style="max-width: 900px; clear: both; float: none; margin: 10px auto; display: block; box-shadow: 2px 2px 2px #ccc; box-sizing: border-box; padding: 10px;">
        <div class="" style="width: 100%; clear: both; float: none; margin-bottom: 10px; position: relative;">
            <span style="position: absolute; right: 9px; top: 10px; padding: 3px; border-radius: 3px; background: #fff;">
                <img class="imgSmall" accept="image/*" onerror="imgError(this);" src="/UploadFiles/QLNV/@hinhA" style="width: 30px;height: auto;">
            </span>

            <ul style="font-size: 20px; text-align: center; margin: 0px; padding: 0px;">
                <li style="display: block; clear: both; float: none; padding: 8px; font-size: 25px; background: #a1e8c4; border-radius: 2px; box-shadow: 0px 3px 0px #eee; text-transform: uppercase; text-shadow: 1px 3px #ccc; margin-bottom: 0px; padding-bottom: 0px;">Nhân viên
                    <div style="text-align: center; font-size: 17px; padding: 5px; color: #ef2f15;">@Model.ho @Model.ten</div>
                </li>
            </ul>
        </div>

        <div class="form-group bs-callout-info " style="padding: 5px; border: 1px solid #eee; border-left-width: 5px; border-radius: 3px; border-left-color: #1b809e; overflow: hidden; margin: 10px 0px;">
            <h4 class="col-md-12" style="margin: 0px; padding: 3px; color: #ff0000 !important; font-weight: bold; font-size: 15px; text-transform: capitalize; color: #1b809e">Thông tin cơ bản<span style="color: red; font-style: italic"></span></h4>
        </div>
        <table class="table table-hover table-striped table-condensed TableMobileChild" style="position: relative; width: 100%">
            <tbody>

                <tr>
                    <td class="tdtitle">Ngày tháng năm sinh</td>
                    <td>@String.Format("{0: dd/MM/yyyy}", Model.ngaySinh)
                    </td>
                    <td class="tdtitle">Nơi sinh</td>
                    <td>@Model.noiSinh</td>
                </tr>
                <tr>
                    <td class="tdtitle">Số CMND</td>
                    <td>
                        @Model.CMNDSo
                    </td>
                    <td class="tdtitle">Ngày cấp</td>
                    <td>@String.Format("{0: dd/MM/yyyy}", Model.CMNDNgayCap)</td>
                </tr>

                <tr>
                    <td class="tdtitle">Nơi cấp</td>
                    <td colspan="3">@Model.CMNDNoiCap
                    </td>


                </tr>
                <tr>
                    <td class="tdtitle">Địa chỉ thường trú<br>
                    </td>
                    <td colspan="3">@Model.thuongTruTenDuong
                    </td>


                </tr>
                <tr>
                    <td class="tdtitle">Địa chỉ tạm trú<br>
                    </td>
                    <td colspan="3">@Model.tamTruTenDuong
                    </td>


                </tr>
                <tr>
                    <td class="tdtitle">Mã nhân viên</td>
                    <td>@Model.maNhanVien
                    </td>
                    <td class="tdtitle">Mã chấm công</td>
                    <td>@Model.maChamCong</td>
                </tr>
                <tr>
                    <td class="tdtitle">Phòng ban</td>
                    <td>@Model.tenPhongBan<span style="color: red; font-style: italic"></span>
                    </td>
                    <td class="tdtitle">Chức danh</td>
                    <td>@Model.tenChucDanh
                    </td>

                </tr>

                <tr>
                    <td class="tdtitle">Ngày bắt đầu làm việc</td>
                    <td>@String.Format("{0: dd/MM/yyyy}", Model.ngayVaoLam)</td>
                    <td class="tdtitle">Số tài khoản</td>
                    <td>@Model.soTaiKhoan</td>
                </tr>


                <tr>

                    <td class="tdtitle">Số điện thoại</td>
                    <td>@Model.phoneNumber1</td>

                    <td class="tdtitle">Email cá nhân</td>
                    <td>@Model.email</td>


                </tr>
                <tr>
                    <td class="tdtitle">Bằng cấp</td>
                    <td colspan="4">
                        @{
                        
                            if (listBangCap != null && listBangCap.Count > 0)
                            {
                            <table id="tbl-nhomCV" class="table table-striped table-hover table-condensed tableThemeCustome container TableMobile IndexBangCapProfile">
                                <thead>
                                    <tr>
                                        <th>STT</th>
                                        <th>Bằng cấp</th>
                                        <th>Năm tốt nghiệp</th>


                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        
                                i = 1;

                                foreach (var itemBC in listBangCap)
                                {
                                        
                                        <tr>
                                            <td style="text-align: center" class="setSizeSTT">@i</td>

                                            <td>
                                                @itemBC.bangCap</td>
                                            <td style="text-align: center">
                                                @itemBC.namTotNghiep</td>



                                        </tr>
                                    i++;
                                }
                                
                                       
                                    }

                                </tbody>

                            </table>
                            }
                        }
                    </td>
                </tr>






            </tbody>
        </table>



        <div class="form-group bs-callout-info " style="padding: 5px; border: 1px solid #eee; border-left-width: 5px; border-radius: 3px; border-left-color: #1b809e; overflow: hidden; margin: 10px 0px;">
            <h4 class="col-md-12" style="margin: 0px; padding: 3px; color: #ff0000 !important; font-weight: bold; font-size: 15px; text-transform: capitalize; color: #1b809e">Thông tin lương</h4>
        </div>
        <table class="table table-hover table-striped table-condensed tableThemeCustome TableMobileChild" style="position: relative; width: 100%">
            <tbody>
                <tr>
                    <td class="tdtitle">Số người phụ thuộc</td>
                    <td colspan="3">@{
                        if (Model.quanHeGiaDinhs != null && Model.quanHeGiaDinhs.Count > 0)
                        {
                        <table class="table table-hover table-striped table-condensed TableMobile IndexQuanHeProfile" style="position: relative; width: 100%">
                            <thead>
                                <tr>
                                    <th>STT</th>
                                    <th>Tên người quan hệ</th>
                                    <th>Mối quan hệ</th>
                                </tr>
                            </thead>
                            @foreach (var item in Model.quanHeGiaDinhs)
                            {
                                <tr>
                                    <td>@count</td>
                                    <td style="text-align: left">@item.tenNguoiQuanHe</td>
                                    <td style="text-align: left">@item.tenLoaiQuanHe</td>

                                </tr> 
                                count++;
                            }
                        </table>
                        }}
                    </td>

                </tr>

                <tr>
                    <td class="tdtitle">Lương hiện tại</td>
                    <td></td>
                    <td class="tdtitle">Phụ cấp công trình</td>
                    <td></td>
                </tr>






            </tbody>
        </table>
    </div>
    <table class="">
    </table>

</fieldset>


