@using BatDongSan.Models.NhanSu;
@model NhanVienModel
@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int i = 1, j = 1, count = 1;
    var listBangCap = ViewBag.listBangCap as List<tbl_NS_NhanVien_BangCap>;
    var listNhanVienPC = ViewBag.ListNhanVien as List<BatDongSan.Models.QuanLyCaLamViec.PhanCaModel>;
}
<link rel="stylesheet" href="~/Content/bootstrap-datetimepicker.min.css" />
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/additional-methods.min.js"></script>
<script src="~/Scripts/batdongsan.validate.js"></script>
<script src="~/Scripts/moment.min.js"></script>
<script src="~/Scripts/vi.js"></script>
<script src="~/Scripts/bootstrap-datetimepicker.min.js"></script>
<script src="~/Scripts/autoNumeric.js"></script>
<script src="~/Scripts/batdongsan.uploadfile.js"></script>

<style>
    .anchor-delete {
        font-style: italic;
        color: #389bf1;
    }

    .numberinputInt, .numberinput {
        text-align: right;
    }

    .parentDCLColor {
        background-color: #cfda22;
        font-size: 15px;
    }
</style>
<style>
    .successOk {
        color: green;
    }
</style>
<script type="text/javascript">
    $(document).ready(function () {
        $("#btnAddNVC").click(function () {
            var row = $("#tbl-nhomCV >tbody>tr:first").clone();
            var rowCount = $("#tbl-nhomCV >tbody>tr").length + 1;
            row.find("input").val("");
            row.find("td:eq(0)").html(rowCount);
            row.find("td:last").find("button").addClass("btnXoa");
            $("#tbl-nhomCV >tbody").append(row);

        });

        $(document).on("click", ".btnXoaTD", function () {
            var rowCount = $("#tbl-nhomCV > tbody>tr").length;
            if (rowCount > 1) {
                $(this).parents("tr")[0].remove();
            }
            else {
                $(".namTotNghiep").val('');

                $(".bangCap").val('');
                Alert.success("Đã xóa dữ liệu.", "Thông báo", { displayDuration: 2000 });

            }
        });
        $("#maChamCong").on("input", function () {
            var maCCBanDau = $("#maCCBanDau").val();
            if ($("#maChamCong").val() != maCCBanDau && $("#maChamCong").val() != "") {
                $.ajax({
                    type: "POST",
                    url: "/DanhSachCongNhan/CheckMaChamCong",
                    data: {

                        maChamCong: $("#maChamCong").val()

                    },
                    error: function () {
                        alert("Error");
                        return false;
                    },
                    success: function (result) {

                        if (result == 1) {

                            $(".maCCInfor").html('Mã chấm công này đã tồn tại').addClass('error').removeClass("successOk");
                            $("#maChamCong").addClass("error");

                            $("#btnSubmit").hide();

                        }
                        else {
                            $(".maCCInfor").html('Mã chấm công này có thể sử dụng').removeClass('error').addClass("successOk");
                            $("#maChamCong").removeClass("error");
                            if ($("#maCongNhan").hasClass("error") == false && $("#maChamCong").hasClass("error") == false) {
                                $("#btnSubmit").show();
                            }
                        }


                    }
                });
            }
            else {
                $(".maCCInfor").html('').removeClass('error').addClass("successOk");
                $("#maChamCong").removeClass("error");
                if ($("#maCongNhan").hasClass("error") == false && $("#maChamCong").hasClass("error") == false) {
                    $("#btnSubmit").show();
                }
            }

        });
        $("#btnSubmit").click(function () {
            var maPhanCa = $("#maPhanCa").val();
            if (maPhanCa == 0 || maPhanCa == '') {
                Alert.warning("Vui lòng chọn phân ca.", "Thông báo", { displayDuration: 2000 });
                return false;
            }
            var maPhongBan = $("#maPhongBan").val();
            if (maPhongBan == '') {
                Alert.warning("Vui lòng chọn phòng ban.", "Thông báo", { displayDuration: 2000 });
                return false;
            }

        });
        $('#btnSearch').click(function () {
            var searchText = $('#searchString').val().replace(/\ /g, '+');
            var url = "@Url.Action("Index", "NhanVien")" + "?searchString=" + searchText;
            beginPaging();
            $('#content').html('<h4>Loading...</h4>').load(url);
            successPaging();
        });
        $("#btnTaoUser").click(function () {
            var maNV = $("#maNhanVien").val();
            var emailNV = $("#email").val();

            var userName = detectEmail(emailNV);
            if (maNV == "" || emailNV == "" || userName == "") {
                Alert.error("Email và Mã NV không đơợc rỗng.", "Thông báo", { displayDuration: 2000 });
                return false;
            }
            bootbox.confirm("Tạo user cho nhân viên: " + maNV + "?", function (result) {
                if (result) {
                    //
                    $.ajax({
                        type: "POST",
                        url: "/NhanVien/CreateUser",
                        data: {

                            maNV: maNV,
                            emailNV: emailNV,
                            userName: userName

                        },

                        success: function (result) {


                            if (result == "true") {
                                Alert.success("Đã tạo user và gửi mail cho nhân viên:" + maNV, "Thông báo", { displayDuration: 5000 });
                                $("#btnTaoUser").remove();
                            }
                            else {
                                Alert.error("Có lỗi xãy ra trong quá trình tạo user.", "Thông báo", { displayDuration: 2000 });
                                return false;
                            }


                        }
                    });
                }
            });

            //
        });
        $(".numberinput").autoNumeric('init', { mDec: 2, lZero: 'deny', aSep: ',', aDec: '.', pSign: 's', vMin: '0' });

        $("#hinhAnh").change(function (evt) {
            var img = document.getElementById("mgAvartar");
            img.src = URL.createObjectURL(evt.target.files[0])
        })

        $("[href=#tab3]").on('shown.bs.tab', function (event) {
            $("#btnSubmit").hide();
            $("#btnModalCreate").show();
        })

        $("[href=#tab3]").on('hide.bs.tab', function (event) {
            $("#btnModalCreate").hide();
            $("#btnSubmit").show();
        })

        $(".btnDownload").click(function () {
            location.href = "/NhanVien/Download/" + this.value;
        })

        $("#btnModalCreate").click(function () {
            var url = "/NhanVien/QuanHeGiaDinh"
            $("#quanhe-content").load(url);
        })

        $("#quanHeModal").on("hide.bs.modal", function () {
            $("#quanhe-content").html("");
        });

        $('#btnPhongBan').click(function () {
            var url = '/NhanVien/PhongBanListTree';
            $('#phongban-panel').load(url);
        })

        $(".datepicker").datetimepicker({
            locale: 'vi',
            format: 'DD/MM/YYYY'
        });

        $("#phongBanModal").on("hide.bs.modal", function () {
            $("#phongban-panel").html("");
        });

        $("#btnTroVe").click(function () {
            location.href = "/NhanVien";
        })

        $("#tamTruTinhThanh, #thuongTruTinhThanh").change(function () {
            var quanHuyen = $(this).parent().next().find("select");
            quanHuyen.empty();
            $.ajax({
                url: "/NhanVien/GetQuanHuyen/" + this.value,
                type: "POST",
                dataType: "json",
                success: function (data) {
                    var textAppend = "<option value=''>[Chọn quận huyện]</option>";
                    $.each(data, function (i, quanHuyen) {
                        textAppend += "<option value=" + quanHuyen.id + ">" + quanHuyen.tenQuanHuyen + "</option>";
                    });
                    quanHuyen.append(textAppend);
                }
            });
        });


        $('#btnCaLamViec, #btnSearchCLV').click(function () {
            var searchString = $("#searchStringCLV").val();
            var url = '@Url.Action("GetListCaLamViec", "NhanVien")' + "?searchString=" + searchString;
            beginPagingCLV();
            $('#filter-panel .panel-default').load(url, function () {
                successPagingCLV();
            });
        });

        $(document).on('click', '.anchor-delete', function () {
            var parentMaPhieu = $(this).closest('tr').attr('class');
            $(this).closest('tr').remove();
            resetSoThuTu();
        });

        $(document).on("click", ".sanphamcb", function () {
            if (false == $(this).prop("checked")) { //if this item is unchecked
                $("[name=check-all]").prop('checked', $(this).prop("checked")); //change "select all" checked status to false
            }
        });


        $(document).on("click", "[name=check-all]", function () {
            $('#filter-panel input:checkbox').not(this).prop('checked', this.checked);
        });

    });


    function resetSoThuTu() {
        $('#tbl-users  .sothutu').each(function (i) {
            $(this).html(i + 1);
        })
    }

    function beginPaging(args) {
        // Animate         
        $('#content').fadeOut('fast');
    }

    function successPaging() {
        // Animate        
        $('#content').fadeIn('fast');
    }


    function deleteImage(obj) {
        var id = $(obj).data("identity"),
            row = $(obj).closest('tr');
        $.ajax({
            url: "/NhanVien/DeleteImage/" + id,
            type: "POST",
            dataType: "json",
            success: function (html) {
                row.remove();
                Alert.success("Xóa thành công!", "Thông báo", { displayDuration: 2000 });
            },
            error: function () {
                Alert.error("Có lỗi xảy ra", "Lỗi", { displayDuration: 2000 });
            }
        })
    }

    function beginPagingCLV(args) {
        // Animate        
        $('#content').fadeOut('fast');
    }

    function successPagingCLV() {
        // Animate
        $('#content').fadeIn('normal');
    }

    function failurePaging() {
        alert("Không thể tải dữ liệu");
    }

    function enterToSeacrh(event) {
        if (event.keyCode == 13)
            $("#btnSearch").click();
    }

    function enterToSeacrhCLV(event) {
        if (event.keyCode == 13)
            $("#btnSearchCLV").click();
    }



    function ChonNhanVien() {      
        var chks = document.getElementsByName("ChekChonSPK");
        var table = document.getElementById("tbody");
        var maCaLamViecPopUps = document.getElementsByName("maCaLamViecPopUp");
        var tenCaLamViecPopUp = document.getElementsByName("tenCaLamViecPopUp");
        
        var thoiGianTuPopUps = document.getElementsByName("thoiGianTuPopUp");
        var thoiGianDenPopUps = document.getElementsByName("thoiGianDenPopUp");

        var idTbody = "tbody";
        var rowsLength = $("#tbody").find('tr').length;
        for (var i = 0; i < chks.length; i++) {
            if (chks.item(i).checked) {
                if (checkCaLamViec(maCaLamViecPopUps.item(i).value) == "2") {
                    var idRandom = Math.floor(Math.random() * 10000);
                    var stringBuilder = "";
                    rowsLength++;
                    stringBuilder += "<tr id='" + idRandom + "'>";
                    stringBuilder += "<td class='sothutu' align='center'>" + rowsLength + "</td>";
                    stringBuilder += "<td style='text-align:left'><a style='color:#519ee5' href='/CaLamViec/Details/'" + maCaLamViecPopUps.item(i).value + "' target='_blank'>" + tenCaLamViecPopUp.item(i).value + "</a>" + "<input name='maCaLV' id='maCaLV" + idRandom + "' style='text-align:right' class='form-control' type='hidden' value='" + maCaLamViecPopUps.item(i).value + "' style='width:100%;'  alt='" + idRandom + "'/>";
                    stringBuilder += "</td>";
                    stringBuilder += "<td style='text-align:left'>" + thoiGianTuPopUps.item(i).value;
                    stringBuilder += "</td>";
                    stringBuilder += "<td style='text-align:left'>" + thoiGianDenPopUps.item(i).value;
                    stringBuilder += "</td>";
                    stringBuilder += "<td align ='center'><a href='javascript:void(0);' class='anchor-delete'><i class='fa fa-times-circle btnCloseX'></i></a></td>";
                    stringBuilder += "</tr>";
                    if ($("#tbody tr").length > 0) {
                        $("#tbody").find("tr").end().append(stringBuilder)
                    } else {
                        $("#tbody").html(stringBuilder);
                    }
                }
            }
        }
    }


    function checkCaLamViec(maCaLamViec) {
        var flag = "2";
        $.each($("[name='maCaLV']"), function (i) {
            if ($(this).val() == maCaLamViec) {
                flag = "1";
            }
        });
        return flag;
    }

</script>
<style>
    td {
        border: none!important;
    }

    .input-group-btn {
        position: absolute;
        font-size: 0;
    }

    body table tr td.removeBorderBkgr, body table tr:hover td.removeBorderBkgr, .table-hover > tbody > tr:hover td.removeBorderBkgr {
        border: none !important;
        background: #FFF !important;
    }
</style>
<form id="form-submit" method="post" action="/NhanVien/Edit/@Model.maNhanVien" enctype="multipart/form-data">
    <fieldset class="removeBorderFieldset">
        <div id="tabs">
            <ul class="ui-tabs-nav">
                <li class="ui-tabs-selected active">
                    <a href="#tab1" data-toggle="tab"><span>Thông tin nhân viên</span></a></li>
                <li class="ui-tabs-selected">
                    <a href="#tab2" data-toggle="tab"><span>Liên hệ</span></a></li>
                <li class="ui-tabs-selected">
                    <a href="#tab3" data-toggle="tab"><span>Quan hệ gia đình</span></a></li>
            </ul>
            <div class="form-group" style="float: right">
                <button class="btn btn-info" id="btnSubmit">Lưu </button>
                @{
                    if ((int)ViewBag.flashCreateUser == 0)
                    {
                
                    <button class="btn btn-info" id="btnTaoUser" type="button"><i class="fa fa-user-plus"></i>Tạo User</button>
                    }}
                <button class="btn btn-info" type="button" style="display: none" data-toggle="modal" data-target="#quanHeModal" id="btnModalCreate">Thêm</button>
                <button class="btn btn-info" type="button" id="btnTroVe">Trở về </button>
            </div>
        </div>
        <div class="tab-content">
            <div class="tab-pane in active" id="tab1">
                <table class="table table-hover table-striped table-condensed TableMobileChild" style="position: relative">
                    <tr>
                        <td class="tdtitle">Phòng ban<span style="font-style: italic; float: right; color: red">*</span></td>
                        <td>
                            @Html.TextBoxFor(model => model.tenPhongBan, new { @class = "form-control", @readonly = "readonly" })
                            @Html.HiddenFor(model => model.maPhongBan, new { required = "required" })
                            <span style="color: red; font-style: italic">@Html.Raw(TempData["PhongBan"])</span>
                        </td>
                        <td>
                            @{
                                if ((int)ViewBag.resultPB == 1)
                                {    
                                <button style="padding-left: -1px; border-radius: 0px 4px 4px 0px" type="button" class="btn btn-primary" id="btnPhongBan" data-toggle="modal" data-target="#phongBanModal">
                                    <span class="glyphicon glyphicon-th-list" aria-hidden="true"></span>&nbsp;Chọn phòng ban</button>
                                }}
                        </td>
                        @{
                            if ((int)ViewBag.resultPC == 1)
                            {
@*<td class="tdtitle">Phân ca: @Html.DropDownListFor(model => model.maPhanCa, ViewBag.ListPhanCas as SelectList, new { @class = "form-control" })</td>*@
                            }
                            else
                            {
                            <td></td>
                            }
                        }
                        <td rowspan="7" style="text-align: center">
                            <div style="text-align: center;">
                                @{string urlImage = String.IsNullOrEmpty(Model.anhDaiDienURL) ? "/Images/card.gif" : Model.anhDaiDienURL;}

                                <img class="Avatar" id="mgAvartar" onerror="imgError(this);" accept="image/*" src="/UploadFiles/QLNV/@(Model.maNhanVien).jpg" style="cursor: auto;max-width: 200px;">
                            </div>
                        </td>

                    </tr>
                    @* <tr>
                        <td class="tdtitle">Thuộc công ty</td>
                        <td>
                            <input name="tenCongTy" id="tenCongTy" class="form-control" readonly="readonly" /></td>
                        <td class="tdtitle">Thuộc bộ phận</td>
                        <td>
                            <input name="tenBoPhan" id="tenBoPhan" class="form-control" readonly="readonly" /></td>

                    </tr>*@
                    <tr>
                        <td class="tdtitle">Mã nhân viên<span style="font-style: italic; float: right; color: red">*</span></td>
                        <td>@Html.TextBoxFor(model => model.maNhanVien, new { @class = "form-control", @readonly = "readonly" })
                            <span style="color: red; font-style: italic">@TempData["MaNhanVien"]</span>
                        </td>
                        <td class="tdtitle">Loại</td>
                        <td>@Html.DropDownListFor(model => model.idLoaiNhanVien, ViewBag.LoaiNhanViens as SelectList, new { @class = "form-control" })</td>

                    </tr>
                    <tr>
                        <td class="tdtitle">Mã chấm công</td>
                        <td>
                            <input type="hidden" value="@Model.maChamCong" name="maCCBanDau" id="maCCBanDau"/>
                            @Html.TextBoxFor(model => model.maChamCong, new { @class = "form-control" })
                            <span style="color: red; font-style: italic">@TempData["MaChamCong"]</span>
                            <span class="maCCInfor"></span>
                        </td>
                        <td class="tdtitle">Học hàm - Học vị</td>
                        <td>@Html.DropDownListFor(model => model.idTrinhDoChuyenMon, ViewBag.HocHams as SelectList, new { @class = "form-control" })</td>

                    </tr>
                    <tr>
                        <td class="tdtitle">Họ<span style="font-style: italic; float: right; color: red">*</span></td>
                        <td>@Html.TextBoxFor(model => model.ho, new { @class = "form-control", required = "required" })</td>
                        <td class="tdtitle">Tên<span style="font-style: italic; float: right; color: red">*</span></td>
                        <td>@Html.TextBoxFor(model => model.ten, new { @class = "form-control", required = "required" })</td>


                    </tr>
                    <tr>
                        <td class="tdtitle">Ngày sinh </td>
                        <td>@Html.TextBoxFor(model => model.ngaySinh, "{0:dd/MM/yyyy}", new { @class = "form-control datepicker" })</td>
                        <td class="tdtitle">Nơi sinh </td>
                        <td>@Html.TextBoxFor(model => model.noiSinh, new { @class = "form-control" })</td>
                    </tr>
                    <tr>
                        <td class="tdtitle">Số CMND </td>
                        <td>@Html.TextBoxFor(model => model.CMNDSo, new { @class = "form-control" })
                            <span style="color: red; font-style: italic">@TempData["CMND"]</span>
                        </td>
                        <td class="tdtitle">Ngày cấp CMND </td>
                        <td>@Html.TextBoxFor(model => model.CMNDNgayCap, "{0:dd/MM/yyyy}", new { @class = "form-control datepicker" })</td>
                        <td class="removeBorderBkgr"></td>
                    </tr>
                    <tr>

                        <td class="tdtitle">Nơi cấp CMND </td>
                        <td>@Html.TextBoxFor(model => model.CMNDNoiCap, new { @class = "form-control" })</td>
                        <td class="tdtitle">Quốc tịch </td>
                        <td>@Html.DropDownListFor(model => model.maQuocTich, ViewBag.QuocTichs as SelectList, new { @class = "form-control" })</td>

                    </tr>
                    <tr>

                        @*   <td class="tdtitle">Văn phòng - Chi nhánh</td>
                        <td>@Html.DropDownListFor(model => model.maChiNhanhVanPhong, ViewBag.ChiNhanhVPs as SelectList, new { @class = "form-control" })</td>*@
                        <td class="tdtitle">Ngày vào làm </td>
                        <td>@Html.TextBoxFor(model => model.ngayVaoLam, "{0:dd/MM/yyyy}", new { @class = "form-control datepicker" })</td>
                        <td class="tdtitle">Email<span style="font-style: italic; float: right; color: red">*</span></td>
                        <td>@Html.TextBoxFor(model => model.email, new { @class = "form-control", type = "email", required = "required" })</td>
                        <td>
                            <input type="file" value="" class="form-control" name="hinhAnh" id="hinhAnh" /></td>
                        <td class="removeBorderBkgr"></td>
                    </tr>
                    <tr>
                        <td class="tdtitle">Bộ phận tính lương</td>
                        <td>@Html.DropDownListFor(model => model.idKhoiTinhLuong, ViewBag.KhoiTinhLuongs as SelectList, new { @class = "form-control" })</td>
                        <td class="tdtitle">Ngân hàng</td>
                        <td>@Html.DropDownListFor(model => model.maChiNhanhNganHang, ViewBag.ChiNhanhNHs as SelectList, new { @class = "form-control" })</td>
                        <td style="text-align: center">@Html.CheckBoxFor(model => model.hoanTatHoSo, new { style = "width:auto" })Hoàn tất hồ sơ?</td>
                        <td class="removeBorderBkgr"></td>
                    </tr>

                    <tr>
                        <td class="tdtitle">Số tài khoản</td>
                        <td>@Html.TextBoxFor(model => model.soTaiKhoan, new { @class = "form-control" })</td>
                        <td class="tdtitle">Mã số thuế</td>
                        <td>@Html.TextBoxFor(model => model.maSoThue, new { @class = "form-control" })</td>
                        <td rowspan="6"></td>
                    </tr>
                    <tr>
                        <td class="tdtitle">Chức danh </td>
                        @{
                        
                            if ((int)ViewBag.resultCD == 1)
                            {
                            <td>@Html.DropDownListFor(model => model.maChucDanh, ViewBag.ChucDanhs as SelectList, new { @class = "form-control" })</td>
                            }
                            else
                            {
                            <td>@Model.tenChucDanh</td>
                            }
                        }
                        <td class="tdtitle">Ngành nghề </td>
                        <td>@Html.DropDownListFor(model => model.maNgheNghiep, ViewBag.Nghenghieps as SelectList, new { @class = "form-control" })</td>
                    </tr>

                    <tr>
                        <td class="tdtitle">Giới tính </td>
                        <td>
                            <label class="radio-inline" style="font-size: 13px">
                                @Html.RadioButtonFor(model => model.gioiTinh, true, new { style = "width:auto" }) Nam
                            </label>
                            <label class="radio-inline" style="font-size: 13px">
                                @Html.RadioButtonFor(model => model.gioiTinh, false, new { style = "width:auto" }) Nữ
                            </label>
                        </td>
                        <td class="tdtitle">Người </td>
                        <td>
                            <label class="radio-inline" style="font-size: 13px">
                                @Html.RadioButtonFor(model => model.laNguoiNgoaiQuoc, true, new { style = "width:auto" }) Việt Nam
                            </label>
                            <label class="radio-inline" style="font-size: 13px">
                                @Html.RadioButtonFor(model => model.laNguoiNgoaiQuoc, false, new { style = "width:auto" }) Nước ngoài
                            </label>
                        </td>
                    </tr>
                    <tr>
                        <td class="tdtitle">Bảo hiểm</td>
                        <td>
                            @Html.CheckBoxFor(model => model.dangBaoHiemNoiKhac, new { style = "width:auto" }) Tham gia bảo hiểm tại nơi khác                           
                        </td>
                        <td class="tdtitle">Hôn nhân </td>
                        <td>
                            <label class="radio-inline" style="font-size: 13px">
                                @Html.RadioButtonFor(model => model.tinhTrangHonNhan, 1, new { style = "width:auto" }) Có gia đình
                            </label>
                            <label class="radio-inline" style="font-size: 13px">
                                @Html.RadioButtonFor(model => model.tinhTrangHonNhan, 2, new { style = "width:auto" }) Độc thân
                            </label>
                            <label class="radio-inline" style="font-size: 13px">
                                @Html.RadioButtonFor(model => model.tinhTrangHonNhan, 3, new { style = "width:auto" }) Ly hôn
                            </label>
                        </td>
                    </tr>
                    <tr>
                        <td class="tdtitle">Dân tộc</td>
                        <td>@Html.DropDownListFor(model => model.idDanToc, ViewBag.DanTocs as SelectList, new { @class = "form-control" })
                        </td>
                        <td class="tdtitle">Tôn giáo    </td>
                        <td class="removeBorderBkgr">
                            @Html.DropDownListFor(model => model.idTonGiao, ViewBag.TonGiaos as SelectList, new { @class = "form-control" })
                        </td>
                    </tr>
                    <tr>
                        <td class="tdtitle">Đã kết nạp Đảng/Đoàn </td>
                        <td>
                            @Html.DropDownListFor(model => model.loaiKetNap, ViewBag.LoaiKetNaps as SelectList, new { @class = "form-control" })
                        </td>
                        <td class="tdtitle" style="display: none">Tình trạng</td>
                        <td style="display: none">
                            <label class="radio-inline" style="font-size: 13px">
                                @Html.RadioButtonFor(model => model.trangThai, 0, new { style = "width:auto" }) Đang làm việc
                            </label>
                            <label class="radio-inline" style="font-size: 13px">
                                @Html.RadioButtonFor(model => model.trangThai, 1, new { style = "width:auto" }) Đã nghỉ việc
                            </label>
                        </td>
                    </tr>
                    <tr>
                        <td class="tdtitle">Tập tin đính kèm</td>
                        <td colspan="4">
                            <div id="dinhkemfile-panel" class="filter-panel">
                                <input type="hidden" id="nguoiUpLoad" value="@Session["TenNhanVien"]" />
                                <div id="container">
                                    <table class="table" id="tbl-uploading">
                                        <thead>
                                            <tr>
                                                <th colspan="2">Tên tài liệu</th>
                                                <th>Người upload</th>
                                                <th>Ngày upload</th>
                                                <th style="width: 100px">
                                                    <input type="file" style="height: 30px; display: none" name="fileDinhKems" id="input-upload" class="form-control" multiple="multiple" value="" />
                                                    <label class="btn btn-info btn-xs btn-link" style="font-size: 12px; font-size: 12px; background: #fff !important; color: black !important;"
                                                        for="input-upload">
                                                        Chọn tập tin</label>

                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model.fileDinhKems)
                                            {
                                                <tr>
                                                    <td style="text-align: left">
                                                        <img style="width:32px; height: 32px" src="@item.thumbnailURL"></td>
                                                    <td>@item.originalFileName</td>
                                                    <td>@item.tenNguoiUpLoad</td>
                                                    <td>@item.ngayLap.Value.ToString("dd/MM/yyyy hh:mm:ss tt")</td>
                                                    <td style="text-align: center">
                                                        <button class="btn btn-link btn-xs btnDownload" type="button" value="@item.id"><i class="fa fa-download" aria-hidden="true"></i></button>
                                                        <a href="#" style="color: #519ee5" onclick="javascript:deleteImage(this)" data-identity="@item.id">Xóa</a>
                                                    </td>
                                                </tr> 
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="tdtitle">Bằng cấp</td>
                        <td colspan="4">
                            <table id="tbl-nhomCV" class="table table-striped table-hover table-condensed tableThemeCustome container">
                                <thead>
                                    <tr>
                                        <th>STT</th>
                                        <th>Bằng cấp</th>
                                        <th>Năm tốt nghiệp</th>

                                        <th>
                                            <button type="button" id="btnAddNVC" class="btn btn-primary btn-xs">
                                                <span class="glyphicon glyphicon-plus"></span>
                                            </button>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        
                                        i = 1;
                                        if (listBangCap != null && listBangCap.Count > 0)
                                        {
                                            foreach (var itemBC in listBangCap)
                                            {
                                        
                                        <tr>
                                            <td style="text-align: center" class="setSizeSTT">@i</td>

                                            <td>
                                                <input name="bangCap" class="form-control bangCap" value="@itemBC.bangCap" /></td>
                                            <td>
                                                <input name="namTotNghiep" class="form-control namTotNghiep" value="@itemBC.namTotNghiep" style="text-align:right"/></td>


                                            <td style="text-align: center">
                                                <button type="button" class="btn btn-warning btn-xs btnXoaTD"><span class="glyphicon glyphicon-minus"></span></button>
                                            </td>
                                        </tr>
                                                i++;
                                            }
                                        }
                                        else
                                        {
                                        <tr>
                                            <td style="text-align: center" class="setSizeSTT">1</td>

                                            <td>
                                                <input name="bangCap" class="form-control namTotNghiep" value="" /></td>
                                            <td>
                                                <input name="namTotNghiep" class="form-control bangCap" value="" style="text-align: right" /></td>


                                            <td style="text-align: center">
                                                <button type="button" class="btn btn-warning btn-xs btnXoaTD"><span class="glyphicon glyphicon-minus"></span></button>
                                            </td>
                                        </tr>
                                        }
                                    }

                                </tbody>

                            </table>
                        </td>
                    </tr>

                    <tr>
                        <td class="tdtitle">Ca làm việc</td>
                        <td colspan="4">
                            <table id="tbl-users" class="table table-striped table-hover table-condensed tableThemeCustome container">
                                <thead>
                                    <tr>
                                        <th>STT</th>
                                        <th>Mã ca</th>
                                        <th>Thời gian từ</th>
                                        <th>Thời gian đến</th>
                                        <th>
                                            <button class="btn btn-primary btn-xs" type="button" data-toggle="modal" id="btnCaLamViec" data-target="#myModal"><span class="glyphicon glyphicon-plus"></span></button>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody id="tbody">
                                    @{
                                        
                                        i = 1;
                                        if (listNhanVienPC != null && listNhanVienPC.Count > 0)
                                        {
                                            foreach (var item in listNhanVienPC)
                                            {
                                        
                                        <tr>
                                            <td style="text-align: center" class="sothutu">@i</td>

                                            <td>
                                                @Html.Hidden("maCaLV", item.MaCa)
                                                <a style="color:blue" href="@Url.Action("Details", "CaLamViec", new { id = item.MaCa })">@item.TenCa</a></td>
                                            <td>
                                                @string.Format("{0:HH:mm}", item.ThoiGianTu)
                                            </td>
                                            <td>
                                                @string.Format("{0:HH:mm}", item.ThoiGianDen)
                                            </td>
                                            <td style="text-align: center">
                                               <a href='javascript:void(0);' class='anchor-delete'><i class='fa fa-times-circle btnCloseX'></i></a>
                                            </td>
                                        </tr>
                                                i++;
                                            }
                                        }                                       
                                    }

                                </tbody>

                            </table>
                        </td>
                    </tr>
                </table>
            </div>
            <div class="tab-pane" id="tab2">
                <table class="table table-hover table-striped table-condensed TableMobileChild" style="position: relative">
                    <tr>
                        <td class="tdtitle">Di động</td>
                        <td colspan="2">@Html.TextBoxFor(model => model.phoneNumber1, new { @class = "form-control" })</td>

                    </tr>
                    <tr>
                        <td class="tdtitle">Điện thoại Cố định</td>
                        <td colspan="2">@Html.TextBoxFor(model => model.phoneNumber2, new { @class = "form-control" })</td>
                    </tr>
                    <tr>
                        <td class="tdtitle">Địa chỉ liên lạc</td>
                        <td colspan="2" class="form-inline">
                            @Html.TextBoxFor(model => model.tamTruTenDuong, new { @class = "form-control", style = "width: 100%", placeholder = "Tên đường" })</td>
                    </tr>
                    <tr>
                        <td class="tdtitle">Tỉnh thành tạm trú</td>
                        <td>@Html.DropDownListFor(model => model.tamTruTinhThanh, ViewBag.TamTruTinhThanhs as SelectList, new { @class = "form-control" })</td>
                        <td>
                            @Html.DropDownListFor(model => model.tamTruQuanHuyen, ViewBag.TamTruQuanHuyens as SelectList, new { @class = "form-control" })
                        </td>
                    </tr>
                    <tr>
                        <td class="tdtitle">Địa chỉ thường trú</td>
                        <td colspan="2" class="form-inline">
                            @Html.TextBoxFor(model => model.thuongTruTenDuong, new { @class = "form-control", style = "width: 100%", placeholder = "Tên đường" })</td>

                    </tr>
                    <tr>
                        <td class="tdtitle">Tỉnh thành thường trú</td>
                        <td>@Html.DropDownListFor(model => model.thuongTruTinhThanh, ViewBag.ThuongTruTinhThanhs as SelectList, new { @class = "form-control" })</td>
                        <td>
                            @Html.DropDownListFor(model => model.thuongTruQuanHuyen, ViewBag.ThuongTruQuanHuyens as SelectList, new { @class = "form-control" })
                        </td>

                    </tr>
                    <tr>
                        <td class="tdtitle">Liên lạc khẩn cấp báo cho</td>
                        <td colspan="2">@Html.TextBoxFor(model => model.nguoiLienLacKhanCap, new { @class = "form-control" })</td>
                    </tr>
                    <tr>
                        <td class="tdtitle">Địa chỉ liên lạc khẩn cấp</td>
                        <td colspan="2">@Html.TextBoxFor(model => model.diaChiLienLacKhanCap, new { @class = "form-control" })</td>
                    </tr>
                    <tr>
                        <td class="tdtitle">Điện thoại liên lạc khẩn cấp</td>
                        <td colspan="2">@Html.TextBoxFor(model => model.phoneLienLacKhanCap, new { @class = "form-control" })</td>
                    </tr>
                    <tr>
                        <td class="tdtitle">Sổ bảo hiểm (nếu có)</td>
                        <td colspan="2">@Html.TextBoxFor(model => model.soBaoHiem, new { @class = "form-control" })</td>
                    </tr>
                    <tr>
                        <td class="tdtitle">Số sổ Lao động</td>
                        <td colspan="2">@Html.TextBoxFor(model => model.soSoLaoDong, new { @class = "form-control" })</td>
                    </tr>
                </table>
            </div>
            <div class="tab-pane" id="tab3">
                @{Html.RenderPartial("PartialEditQuanHeGD", Model);}
            </div>
        </div>
    </fieldset>
</form>

