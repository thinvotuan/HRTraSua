@using BatDongSan.Models.NhanSu;
@model IPagedList<sp_NS_NhanVien_Index2Result>
@{
    Layout = null;
    int i = 1;
    int page_ = Convert.ToInt32(ViewBag.page);
    int total_ = Convert.ToInt32(ViewBag.total);
}
<style>
    td
    {
        border: none;
    }
</style>
<script type="text/javascript">
    $(document).ready(function () {
        @*$('#btnSearch').click(function () {
            var searchText = $('#searchString').val().replace(/\ /g, '+');
            var url = "@Url.Action("Index", "NhanVien")" + "?searchString=" + searchText;
            beginPaging();
            $('#content').html('<h4>Loading...</h4>').load(url);
            successPaging();
        });*@

        $('.btnChon').click(function () {
            var selected = $(this).parent();
            if (selected.length != 0) {
                var hoten = selected.find('#hoten').val();
                var manv = selected.find('#manhanvien').val();
                $('#nhanvien').val(hoten);
                $('#manv').val(manv);
                //$('.panel-default').html('');
            }
            //$('#filter-panel').removeClass('in');
        })
    })
</script>
<table class="table table-striped table-hover table-condensed TableMobile IndexNhanVienMainMobile" id="maintable">
    <thead>
        <tr>
            <th style="text-align: center; width: 40px">STT</th>
            <th style="width: 170px">Mã nhân viên</th>
            <th style="min-width: 250px">Liên hệ</th>
            <th style="width: 100px">Ngày vào làm</th>
            <th>Phòng ban</th>
            <th style="width: 90px">Loại</th>
            <th style="width: 110px">Tình trạng làm việc</th>
            <th>Lịch sử nhân viên</th>
            <th style="width: 100px">Thao tác</th>
        </tr>
    </thead>
    <tbody>
           @{
             
               var ls = ViewData["lsDanhSach"] as List<sp_NS_NhanVien_Index2Result>;
            if (ls != null){
    foreach (var item in ls.ToList())
    {                                                     
            <tr>
                <td style="text-align: center">@i</td>
                <td style="text-align: left">
                    <a style="color:#519ee5" href="@Url.Action("Details", "NhanVien", new { id = item.maNhanVien })">@item.maNhanVien</a><br />
                    <i class="fa fa-user" aria-hidden="true"></i>@item.hoVaTen
                </td>
                <td style="text-align: left"><i class="fa fa-phone" aria-hidden="true"></i>@item.phoneNumber1<br />
                    <i class="fa fa-envelope-o" aria-hidden="true"></i>@item.email
                </td>
                <td>@Html.Raw(item.ngayVaoLam.HasValue ? item.ngayVaoLam.Value.ToString("dd/MM/yyyy") : string.Empty)</td>
                <td style="text-align: left">@item.tenPhongBan<br />
                    <i class="fa fa-ticket" aria-hidden="true"></i>@item.TenChucDanh
                </td>
                <td>@item.tenLoaiNhanVien</td>
                <td>@item.trangThaiHoatDong</td>
                <td>
                    <div onclick="showHistory('@item.maNhanVien')" class=" hvr-underline-from-center" style="color:green; cursor:pointer">Xem</div>
                </td>
                <td style="text-align: center">
                    <div class="buttons">
                        <a href="@Url.Action("Edit", "NhanVien", new { id = item.maNhanVien })" title ="Sửa phiếu"><i class="fa fa-pencil-square-o" style="font-size: 30px; color: orange;" aria-hidden="true"></i></a>
                        @{     
            if (item.userName == null)
            {
                            <span style="font-size: 30px; color: orange;">|</span><a class="btnDelete" alt="@item.maNhanVien" title ="Xoá phiếu"><i class="fa fa-trash" style="font-size: 30px; color: red; cursor: pointer;" aria-hidden="true"></i></a>
            }}
                    </div>
                </td>
            </tr> 
            i++;
        }
        }
        }
        <tr>
    <td colspan="9" style="text-align:left">
        @{
                
            if (page_ > 1)
            {
        
            <a class="pageFirst" href="javascript:void(0)" onclick="javascript:OnCriteriaPC(1);">First</a> <a class="pagePrevious" href="javascript:void(0)" onclick="javascript:OnCriteriaPC(@(page_ - 1));">
                Previous</a>
       
            }


            if (page_ - 2 >= 1)
            { 
            <a class="pageCurrent" href="javascript:void(0)" onclick="javascript:OnCriteriaPC(@(page_ - 2));">
                @(page_ - 2) </a> <a class="pageCurrent" href="javascript:void(0)" onclick="javascript:OnCriteriaPC(@(page_ - 1));">
                    @(page_ - 1) </a>
            } <span class="pageActive">@page_</span>
            if (page_ + 2 <= total_)
            { 
            <a class="pageCurrent" href="javascript:void(0)" onclick="javascript:OnCriteriaPC(@(page_ + 1) );">
                @(page_ + 1) </a> <a class="pageCurrent" href="javascript:void(0)" onclick="javascript:OnCriteriaPC(@(page_ + 2));">
                    @(page_ + 2) </a>
            }

            if (page_ < total_)
            { 
        
            <a class="pageNext" href="javascript:void(0)" onclick="javascript:OnCriteriaPC(@(page_ + 1));">Next</a> <a class="pageLast" href="javascript:void(0)" onclick="javascript:OnCriteriaPC(@total_);">
                Last</a>
        
            }
        
            <span>Tổng số dòng :</span><strong>@ViewBag.totalRow</strong>
        }
    </td>
</tr>
    </tbody>
</table>
