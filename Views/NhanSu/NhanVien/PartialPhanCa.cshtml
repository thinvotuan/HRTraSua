@using BatDongSan.Models.NhanSu;
@{     
    Layout = null;
    int i = 1;
    var list = ViewBag.ListPhanCa as List<tbl_NS_CaLamViec>;
}
<div id="content">
    <table class="table table-striped table-hover table-condensed TableMobile" id="maintable">
        <thead>
            <tr id="trtop">
                <th style="width: 45px">STT</th>
                <th>Tên ca</th>
                <th>Thời gian bắt đầu</th>
                <th>Thời gian kết thúc</th>
                <th>Ghi chú</th>
                <th style="width: 40px; text-align: center">
                    <input type="checkbox" name="check-all" id="check-all">
                </th>
            </tr>
        </thead>
        @foreach (var item in list)
        {
            string bg = "", title = "";           
            <tr>
                @Html.Hidden("maCaLamViecPopUp", item.maCa)
                @Html.Hidden("tenCaLamViecPopUp", item.tenCa)
                @Html.Hidden("thoiGianTuPopUp", string.Format("{0:HH:mm}", item.thoiGianTu))
                @Html.Hidden("thoiGianDenPopUp", string.Format("{0:HH:mm}", item.thoiGianDen))
                <td style="text-align: center;@bg" title="@title"  class="setSizeSTT">@i</td>
                <td>
                    @if (item.trangThai == 1)
                    {
                        <a style="color:blue" href="@Url.Action("Details", "CaLamViec", new { id = item.maCa })">@item.tenCa</a>
                    }
                </td>
                <td style="text-align: center">
                    @string.Format("{0:HH:mm}", item.thoiGianTu)
                </td>
                <td style="text-align: center">
                    @string.Format("{0:HH:mm}", item.thoiGianDen)
                </td>
                <td>
                    @item.ghiChu
                </td>
                <td style="text-align: center">
                    <input type="checkbox" name="ChekChonSPK" class="sanphamcb" value="@item.maCa"/>
                </td>
            </tr>
                    i++;
        }
    </table>
</div>
