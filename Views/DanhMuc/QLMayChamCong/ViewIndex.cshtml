@using BatDongSan.Models.DBChamCong;
@{
    int i = 1;
    int page_ = Convert.ToInt32(ViewBag.page);
    int total_ = Convert.ToInt32(ViewBag.total);

    var LstCongTrinh = ViewBag.LstCongTrinh as List<Sys_SiteConection>;
}



@{
   
    var danhSach = ViewData["lsDanhSach"] as List<Sp_ViewMachinePBResult>;

                    if (danhSach != null)
                    {
                        int stt = 1;
                        foreach (var data in danhSach.OrderBy(d => d.siteId))
                        {
                        
                
                    <tr id="@data.machineId">
                        <td style="text-align: center">
                            @stt
                        </td>
                        <td>
                            @data.machineId
                        </td>
                        <td>
                            <input type="text" value="@data.MachineName" class="MachineName form-control"/>
                        </td>
                        <td>
                            <select class="form-control siteCongTrinh">
                                @{
                            foreach (var item in LstCongTrinh)
                            {
                                if (item.siteId == data.siteId)
                                {
                                    <option value="@item.siteId" selected>
                                        @item.siteName
                                    </option>
                                }
                                else
                                {
                                    <option value="@item.siteId">
                                        @item.siteName
                                    </option>
                            
                                }
                            }
                                }

                            </select>
                        </td>

                        @if (data.trangThai == 1)
                        {
                            <td style="text-align:center">Online
                            </td>
                        }
                        else
                        {
                            <td style="color: Red; text-align:center">Offline
                            </td>
               
                        }
                        @Html.Hidden("status", data.trangThai)


                        <td style="text-align:center">
                            @if (data.typeMachine == 1)
                            { 
                                <span>Máy vào</span>
                            }
                            else if (data.typeMachine == 2)
                            {
                                <span>Máy ra</span>
                            }
                        </td>
                        <td>
                            <input type="text" value="@data.remark" class="remark form-control" />
                        </td>
                       @* <td style="text-align: center">
                                    <button type="button" class="btn btn-warning btn-xs btnXoaMayCC"><span class="glyphicon glyphicon-minus"></span></button>
                                </td>*@

                    </tr>
                            stt++;
                        }
                    }
                
            
}

