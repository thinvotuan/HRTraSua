        $(document).on("click", ".btnEditMaChine", function () {
            var url = "@Url.Action("EditMachine", "DanhSachMayChamCong")" + "/" + this.value;
            var form = document.getElementById("form-submitMachine");
            form.action = url;
            $("#custom-panelMachine").load(url);
        });

        $(document).on("click", ".btnDeleteMachine", function () {
            var MachineID = this.value;
            bootbox.confirm("Xóa máy: " + MachineID + " ?", function (result) {
                if (result) {

                    var url = "@Url.Action("DeleteMachine", "DanhSachMayChamCong")" + "/" + MachineID;
                    $.ajax({
                        url: url,
                        type: "POST",
                        dataType: "html",
                        success: function (html) {
                            $("#ViewBody").html(html);
                            Alert.success("Xóa thành công!", "Thông báo", { displayDuration: 2000 });
                        },
                        error: function () {
                            Alert.error("Có lỗi xảy ra, Vui lòng kiểm tra lại!", "Thông báo", { displayDuration: 2000 });
                        }
                    });
                }
            });
        });
        $(document).on("click", ".btnEditSite", function () {
            var url = "@Url.Action("EditSite", "DanhSachMayChamCong")" + "/" + this.value;
            var form = document.getElementById("form-submitSite");
            form.action = url;
            $("#custom-panelSite").load(url);
        });

        $(document).on("click", ".btnDeleteSite", function () {
            var MachineID = this.value;
            bootbox.confirm("Xóa Site: " + MachineID + " ?", function (result) {
                if (result) {

                    var url = "@Url.Action("DeleteSite", "DanhSachMayChamCong")" + "/" + MachineID;
                    $.ajax({
                        url: url,
                        type: "POST",
                        dataType: "html",
                        success: function (html) {
                            location.href = '/DanhSachMayChamCong/Index';
                            Alert.success("Xóa thành công!", "Thông báo", { displayDuration: 2000 });
                        },
                        error: function () {
                            Alert.error("Có lỗi xảy ra, Vui lòng kiểm tra lại!", "Thông báo", { displayDuration: 2000 });
                        }
                    });
                }
            });
        });

        $(document).on("click", "#btnSubmitSite", function () {

            
            var kqCheck = 0;
            $("[required=required],[required=true]").each(function () {

                if ($(this).val() == "") {
                    $(this).addClass("error");
                    kqCheck = 1;
                }
                else {
                    $(this).removeClass("error");
                }
            });
            if (kqCheck == 0) {
                var url = $("#form-submitSite").attr("action");
                $.ajax({
                    url: url,
                    type: "POST",
                    dataType: "html",
                    data: $('#form-submitSite').serialize(),
                    success: function () {

                       
                        location.href = '/DanhSachMayChamCong/Index';
                    },
                    error: function () {
                        Alert.error("Có lỗi xảy ra, Vui lòng kiểm tra lại!", "Thông báo", { displayDuration: 2000 });
                    }
                });
            }
            else {
                return false;
            }

        });
        $("#btnSubmitMachine").click(function () {
            var kqCheck = 0;
            $("[required=required],[required=true]").each(function () {

                if ($(this).val() == "") {
                    $(this).addClass("error");
                    kqCheck = 1;
                }
                else {
                    $(this).removeClass("error");
                }
            });
            if (kqCheck == 0) {
                var url = $("#form-submitMachine").attr("action");
                $.ajax({
                    url: url,
                    type: "POST",
                    dataType: "html",
                    data: $('#form-submitMachine').serialize(),
                    success: function () {
                        //$("#ViewBody").html(html);
                        //Alert.success("Lưu thành công!", "Thông báo", { displayDuration: 2000 });
                        //$(".btnClosePopup").click();
                        location.href = '/DanhSachMayChamCong/Index';
                    },
                    error: function () {
                        Alert.error("Có lỗi xảy ra, Vui lòng kiểm tra lại!", "Thông báo", { displayDuration: 2000 });
                    }
                });
            }
            else {
                return false;
            }
        });
        $("#btnModalCreateSite").click(function () {
            var url = "@Url.Action("CreateSite", "DanhSachMayChamCong")";
            var form = document.getElementById("form-submitSite");
            form.action = url;
            $("#custom-panelSite").load(url);
        });

        $("#btnModalCreateMachine").click(function () {
            var url = "@Url.Action("CreateMaChine", "DanhSachMayChamCong")";
            var form = document.getElementById("form-submitMachine");
            form.action = url;
            $("#custom-panelMachine").load(url);
        });

        $("#customModal").on("hide.bs.modal", function () {
            $("#nhanVien-panel").html("");
        });

    });

</script>
<form>
    <div id="container">
        <fieldset class="removeBorderFieldset">

            <div id="tabs" style="" class="ui-tabs">
                <ul class="ui-tabs-nav">
                    <li class="ui-tabs-selected ui-state-active tabToggle activeColorTab tabXL"><a><span><i class="fa fa-line-chart"></i>Danh sách máy chấm công</span></a></li>
                    <li class="ui-state-default ui-corner-top tabToggle tabCT">
                        <a href="#" class="hvr-underline"><span><i class="fa fa-signal" aria-hidden="true"></i>Danh sách site connection</span></a></li>
                </ul>
            </div>
            <div id="filter-panel" class="collapse filter-panel" style="display: block">

                <div class="panel panel-default background_top">
                    <div class="panel-body">
                        <div class="form-group" style="float: right">
                            <button class="btn btn-info" id="btnModalCreateSite" type="button" data-toggle="modal" data-target="#customModalSite">Thêm Site Connection</button>
                            <button class="btn btn-info" id="btnModalCreateMachine" type="button" data-toggle="modal" data-target="#customModalMachine">Thêm Machine </button>
                        </div>
                    </div>
                </div>
            </div>
            <div id="content">
                <div class="contentToggle">
                    <table class="table table-striped table-hover table-condensed" id="maintable">
                        <thead>
                            <tr>
                                <th>STT
                                </th>
                                <th>Mã máy
                                </th>
                                <th>Tên máy
                                </th>
                                <th>Tên công trường/VP.
                                </th>
                                <th>Trạng thái
                                </th>


                                <th>Loại máy
                                </th>
                                <th>ghi chú
                                </th>
                                <th>Thao tác</th>

                            </tr>
                        </thead>
                        <tbody id="ViewBody">
                            @{Html.RenderPartial("_ViewIndex");}
                        </tbody>
                    </table>
                </div>
                <div class="contentToggle" style="display: none">
                    <table class="table table-striped table-hover table-condensed" id="maintable">
                        <thead>
                            <tr>
                                <th>STT
                                </th>
                                <th>SiteId
                                </th>
                                <th>SiteName
                                </th>
                                <th>SiteAddress
                                </th>
                                <th>SiteIP
                                </th>


                                <th>Port
                                </th>
                                <th>Database
                                </th>
                                <th>Login
                                </th>
                                <th>Pdw</th>

                                <th>Remark</th>
                                <th>Người lập</th>
                                <th></th>


                            </tr>
                        </thead>
                        <tbody id="ViewBodySite">
                            @{Html.RenderPartial("_ViewIndexSite");}
                        </tbody>
                    </table>
                </div>
            </div>
        </fieldset>
    </div>
</form>
<form id="form-submitSite" method="post">
    <!--------------------------- Modal - Thêm Sửa Modal Form ------------------------>
    <div id="customModalSite" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-body">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title"></h4>
                    </div>
                    <div class="container" style="width: 100%">
                        <div class="row">
                            <div id="custom-panelSite" class="filter-panel">
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-primary btn-sm Edit" type="button" id="btnSubmitSite">
                            Lưu
                        </button>
                        <button type="button" class="btn btn-default btnClosePopup" data-dismiss="modal">Đóng</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
<form id="form-submitMachine" method="post">
    <!--------------------------- Modal - Thêm Sửa Modal Form ------------------------>
    <div id="customModalMachine" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-body">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title"></h4>
                    </div>
                    <div class="container" style="width: 100%">
                        <div class="row">
                            <div id="custom-panelMachine" class="filter-panel">
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-primary btn-sm Edit" type="button" id="btnSubmitMachine">
                            Lưu
                        </button>
                        <button type="button" class="btn btn-default btnClosePopup" data-dismiss="modal" id="btnCloseEmail">Đóng</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
