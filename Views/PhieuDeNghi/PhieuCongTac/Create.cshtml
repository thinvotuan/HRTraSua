@using BatDongSan.Models.PhieuDeNghi;
@model PhieuDeNghiCongTac
@{
    ViewBag.Title = "Đăng ký phiếu công tác, nghỉ bù";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/Content/summernote/summernote.css" />
<script src="~/Content/summernote/summernote.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/additional-methods.min.js"></script>
<script src="~/Scripts/autoNumeric.js"></script>
<script src="~/Scripts/batdongsan.validate.js"></script>
<script src="~/Scripts/moment.min.js"></script>
<script src="~/Scripts/vi.js"></script>
<script src="~/Scripts/bootstrap-datetimepicker.min.js"></script>
<link rel="stylesheet" href="~/Content/bootstrap-datetimepicker.min.css" />
<script>
    $(document).ready(function () {
        $(".numberinput").autoNumeric('init', { mDec: 0, mNum: 3, lZero: 'deny', aSep: ',', aDec: '.', pSign: 's', vMin: '0' });
        $(".numberinputInt").autoNumeric('init', { lZero: 'deny', mDec: 0, pSign: 's', aSep: ',', aDec: '.' });
        $("#btnTroVe").click(function () {
            var url = "@Url.Action("Index")";
            location.href = url;
        });
        $('#editor').summernote({
            height: 150,                 // set editor height
            minHeight: null,             // set minimum height of editor
            maxHeight: null             // set maximum height of editor
            //focus: true                  // set focus to editable area after initializing summernote
        });
        $(".timepicker").datetimepicker({
            locale: 'vi',
            format: 'HH:mm'
        });

        $(".datepicker").datetimepicker({
            locale: 'vi',
            format: 'DD/MM/YYYY',
            useCurrent: false
        });

        $("#nghiBuTheoGio").change(function () {

            if ($("#nghiBuTheoGio").is(":checked")) {
                $(".errorCheckbox").removeClass("error");
                $("#congTacNgoai").prop("checked", false);
                checkEndTime();
                $(".nghiTheoGio").show();
                $.post('@Url.Action("GetSoNgayTangCa", "PhieuCongTac")', { maNhanVien: $("#NhanVien_maNhanVien").val() }, function (data) {

                    $("#soGioConLaiNghiBu").val(data.soGioConLai);
                    $("#tongGioTangCa").val(data.soGioTangCa);
                    //tinhTimeNghiThucTe();
                   
                });
               
                $("#noiDenCongTacNgoai").removeClass("required");
                $(".nghiTheoNgay").hide();
            }
            else {
                $(".nghiTheoGio").hide();
                $(".nghiTheoNgay").show();
            }
            //nghiTheoGio
        });
        
        $("#btnSubmit").click(function () {
           
            if (!$("#nghiBuTheoGio").is(":checked") && !$("#congTacNgoai ").is(":checked")) {
                Alert.error("Bạn phải chọn loại phiếu: công tác / nghỉ bù.", "Thông báo", { displayDuration: 3000 });
                $("#congTacNgoai").addClass('error');
                $(".errorCheckbox").addClass("error");
                return false;
            }
            $(".errorCheckbox").removeClass("error");
            if ($("#nghiBuTheoGio").is(":checked")) {
                var soGioConLaiNghiBu = $("#soGioConLaiNghiBu").val();
                if (soGioConLaiNghiBu < -8) {
                    Alert.error("Số giờ còn lại nghỉ bù không được nhỏ hơn -8h.", "Thông báo", { displayDuration: 3000 });
                    return false;
                }
                $("#form-submit").submit();
                return false;
            }
            if (CheckForm()) {
                //var noiDung = $("#ghiChu").val();

                //if (noiDung == "") {
                //    Alert.error("Vui lòng nhập nội dung công tác.", "Thông báo", { displayDuration: 3000 });
                //    return false;
                //}

                var startDate = $("#ngayBatDau").val();
                var endDate = $("#ngayKetThuc").val();
                $.post('@Url.Action("Generate", "PhieuCongTac")', { dateOne: startDate, dateTwo: endDate }, function (data) {
                    if (data != null) {
                        $("#soNgayCongTac").val(data.soNgay);
                        $("#form-submit").submit();
                    }
                });
            }
        });


        $("#rad-1").click(function () {
            $("#maTinh").val("");
            $("#maQuocGia").val("");
            $("#maTinh").removeClass("error").css("display", "block");
            $("#maQuocGia").removeClass("error").css("display", "none");
        });


        $("#rad-2").click(function () {
            $("#maQuocGia").val("");
            $("#maTinh").val("");
            $("#maTinh").removeClass("error").css("display", "none");
            $("#maQuocGia").removeClass("error").css("display", "block");
        });

        $("#ChoosePB").click(function () {
            ChonPhongBan();
        });

        $("#ChooseNV").click(function () {
            ChonNhanVien();
        });
        $("#congTacNgoai").change(function () {
            $("#noiDenCongTacNgoai").val('');
            if (this.checked) {
                $(".showCTngoai").show();
                $("#noiDenCongTacNgoai").removeClass("required");
                $(".nghiTheoNgay").show();

            } else {

                $(".showCTngoai").hide();
                $("#noiDenCongTacNgoai").removeClass("required");
            }
            if ($("#congTacNgoai").is(":checked")) {
                $(".errorCheckbox").removeClass("error");
                $("#nghiBuTheoGio").prop("checked", false);
                $(".nghiTheoGio").hide();
                $(".nghiTheoNgay").show();
            }

        });
        $(document).on("dp.hide", "#ngayBatDau", function (e) {
            $("#ngayKetThuc").val("");


            var ngayBatDau = moment(this.value, 'DD-MM-YYYY');
            $("#ngayKetThuc").data("DateTimePicker").minDate(ngayBatDau.add(0, "day"), function () {
                return;
            });

            $.post('@Url.Action("checkNgayBatDau", "PhieuCongTac")', { ngayBatDau: moment(e.date).format("DD/MM/YYYY"), maNhanVien: $("#NhanVien_maNhanVien").val() }, function (data) {
                if (data == 2) {
                    $("#ngayBatDau").val("");
                    Alert.error("Ngày này đã được tạo phiếu công tác, vui lòng chọn lại ngày công tác khác", "Thông báo", { displayDuration: 3000 });

                }
            });
            Generate();
        });
        $(document).on("dp.change", "#ngayKetThuc", function (e) {

            var date = new Date();
            //var expire = moment().subtract(0, "day");
            //$(this).data("DateTimePicker").minDate(expire, function () {
            //    return;
            //});
            var ngayBD = $('#ngayBatDau').val();
            var ngayKT = $('#ngayKetThuc').val();

            var d1 = Date.parse(convertDate(ngayBD));
            var d2 = Date.parse(convertDate(ngayKT));
            if ($("#nghiBuTheoGio").is(":checked")) {
                if (d1 != d2) {
                    Alert.error("Nghỉ theo giờ: ngày kết thúc phải giống ngày bắt đầu. Vui lòng nhập lại.", "Thông báo", { displayDuration: 5000 });
                    $("#ngayKetThuc").val("");
                    return false;
                }
            }
            if (d1 > d2) {
                Alert.error("Ngày kết thúc lớn hơn ngày bắt đầu. Vui lòng nhập lại.", "Thông báo", { displayDuration: 3000 });
                $("#ngayKetThuc").val("");
            }
            Generate();
        });



    });
    function tinhTongGioTangCa() {
        $.post('@Url.Action("GetSoNgayTangCa", "PhieuCongTac")', { maNhanVien: $("#NhanVien_maNhanVien").val() }, function (data) {

            $("#soGioConLaiNghiBu").val(data.soGioConLai);
            $("#tongGioTangCa").val(data.soGioTangCa);

        });
    }
    function checkEndTime() {
       
        var valueStartTime = $("#gioBatDau").val();
        var valueEndTime = $("#gioKetThuc").val();
        var startTimeSplit = valueStartTime.split(':');
        var endTimeSplit = valueEndTime.split(':');
        if (parseFloat(endTimeSplit[0]) < parseFloat(startTimeSplit[0])) {
            $("#gioKetThuc").val('');
            $("#gioKetThuc").focus();
            $("#gioKetThuc").addClass("error").attr("title", "Giờ kết thúc > giờ bắt đầu");
        }
        else {
            if (parseFloat(endTimeSplit[0]) == parseFloat(startTimeSplit[0])) {
                if (parseFloat(endTimeSplit[1]) < parseFloat(startTimeSplit[1])) {
                    $("#gioKetThuc").val('');
                    $("#gioKetThuc").focus();
                    $("#gioKetThuc").addClass("error").attr("title", "Giờ kết thúc > giờ bắt đầu");
                }
            }
        }
        TinhThoiGianTangCa();
    }
    function TinhThoiGianTangCa() {
        var valueStartTime = $("#gioBatDau").val();
        var valueEndTime = $("#gioKetThuc").val();
        var startTimeSplit = valueStartTime.split(':');
        var endTimeSplit = valueEndTime.split(':');
        var starDateGio = parseFloat(startTimeSplit[0]);
        var startDatePhut = parseFloat(startTimeSplit[1]);
        var endDateGio = parseFloat(endTimeSplit[0]);
        var endDatePhut = parseFloat(endTimeSplit[1]);
        var soGio = 0;
        var soPhut = 0;
        var soPhutNew = 0;
        if (endDateGio >= starDateGio) {
            if (endDatePhut >= startDatePhut) {
                soGio = endDateGio - starDateGio;
                soPhut = endDatePhut - startDatePhut;
                if (soPhut < 10) { soPhut = "0" + soPhut }
                soPhutNew = soGio + ":" + soPhut;
                //$("#soGioTangCaHidden").val(soPhutNew);
                $("#soGioNghiBu").val(soPhutNew);
            }
            else {
                soGio = endDateGio - starDateGio - 1;
                soPhut = 60 - startDatePhut + endDatePhut;
                if (soPhut < 10) { soPhut = "0" + soPhut }
                soPhutNew = soGio + ":" + soPhut;
                //$("#soGioTangCaHidden").val(soPhutNew);
                $("#soGioNghiBu").val(soPhutNew);
            }

        }
        tinhTimeNghiThucTe();

    }
    function tinhTimeNghiThucTe() {
        var soGioNghiBu = parseFloat($("#soGioNghiBu").val().split(':')[0]);
        $.post('@Url.Action("GetSoNgayTangCa", "PhieuCongTac")', { maNhanVien: $("#NhanVien_maNhanVien").val() }, function (data) {

          
           
            var tongGioTangCa = parseFloat(data.soGioConLai);
            $("#soGioConLaiNghiBu").val((tongGioTangCa - soGioNghiBu).toFixed(2));
        });
        

    }
    function Generate() {
        var startDate = $("#ngayBatDau").val();
        var endDate = $("#ngayKetThuc").val();
        $.post('@Url.Action("Generate", "PhieuCongTac")', { dateOne: startDate, dateTwo: endDate }, function (data) {
            if (data != null) {
                $("#soNgayCongTac").val(data.soNgay);
            }
        });
    }
    function CheckForm() {
        var flag = true;
        if ($("#soNgayCongTac").val() == "" || $("#soNgayCongTac").val() == "0" || parseFloat($("#soNgayCongTac").val()) < 0) {
            $("#soNgayCongTac").addClass("error").attr("title", "Số ngày công tác phải lớn hơn 0");
            flag = false;

        }

        if ($("#lyDo").val() == "") {
            $("#lyDo").addClass("error").attr("title", "Vui lòng nhập lý do.");
            flag = false;

        }
        if ($("#rad-1").is(":checked")) {
            $("#maQuocGia").removeClass("error");
            if ($("#maTinh").val() == "") {
                $("#maTinh").addClass("error").attr("title", "Vui lòng chọn nơi công tác.");
                flag = false;
            }

        }
        else if ($("#rad-2").is(":checked")) {
            $("#maTinh").removeClass("error");
            if ($("#maQuocGia").val() == "") {
                $("#maQuocGia").addClass("error").attr("title", "Vui lòng chọn nơi công tác.");;
                flag = false;
            }

        }
        var ngayBD = $("#ngayBatDau").val();
        var ngayKT = $("#ngayKetThuc").val();
        if (ngayBD == "" || ngayKT == "") {
            Alert.error("Chọn ngày công tác.", "Thông báo", { displayDuration: 3000 });
            $("#ngayKetThuc,#ngayBatDau").val("");
            flag = false;
        }
        var d1 = Date.parse(convertDate(ngayBD));
        var d2 = Date.parse(convertDate(ngayKT));
        if ($("#nghiBuTheoGio").is(":checked")) {
            if (d1 != d2) {
                Alert.error("Nghỉ theo giờ: ngày kết thúc phải giống ngày bắt đầu. Vui lòng nhập lại.", "Thông báo", { displayDuration: 5000 });
                $("#ngayKetThuc").val("");
                return false;
            }
        }
        if (d1 > d2) {
            Alert.error("Ngày kết thúc lớn hơn ngày bắt đầu. Vui lòng nhập lại.", "Thông báo", { displayDuration: 3000 });
            $("#ngayKetThuc").val("");
            flag = false;
        }
        return flag;
    }

    function PopUpManager(url, title, w, h) {
        var left = (screen.width / 2) - (w / 2);
        var top = (screen.height / 2) - (h / 2);
        var targetWin = window.open(url, title, 'width=' + w + ', height=' + h + ', top=' + top + ', left=' + left);
    }
    function ChonPhongBan() {
        var url = ('@Url.Action("DanhSachPhongBan/", "PhieuCongTac")');
        PopUpManager(url, "DUYET", 980, 500);
    }

    function ChonNhanVien() {
        var url = ('@Url.Action("DanhSachNVPB/", "PhieuCongTac")');
        PopUpManager(url, "DUYET", 980, 500);
    }

</script>
<style>
    #tbl-create td {
        border: none;
    }
    .errorCheckbox.error .checkbox-inline {
    color:red;
  
    }
    
</style>
<form id="form-submit" class="form-horizontal" method="post">
    <div id="container" class="custome_fieldSet">
        <fieldset class="removeBorderFieldset">
            <div id="tabs" style="height: auto; border: none; float: left; box-sizing: border-box; overflow: hidden; clear: none;" class="ui-tabs ui-widget ui-widget-content ui-corner-all">
                <ul class="ui-tabs-nav ui-helper-reset ui-helper-clearfix ui-widget-header ui-corner-all">
                    <li class="ui-state-default ui-corner-top ui-tabs-selected ui-state-active ">
                        <a><span><i class="fa fa-plus-square-o" aria-hidden="true"></i>Thêm mới phiếu công tác, nghỉ bù</span></a></li>
                </ul>
            </div>
            <table class="table table-striped table-hover table-condensed TableMobileChild" id="tbl-create" style="position: relative">
                @if ((string)ViewBag.AdminNhanSu == "true")
                {
                    <tr>
                        <td style="width: 15%" class="tdtitle">MNV lập phiếu TT</td>
                        <td style="width: 35%">@Html.TextBoxFor(model => model.NhanVienLapPhieuTT.maNhanVien, new { @class = "form-control", @readonly = true })</td>
                        <td style="width: 15%" class="tdtitle">Họ tên NV lập phiếu TT</td>
                        <td style="width: 35%">
                            @Html.TextBoxFor(model => model.NhanVienLapPhieuTT.hoVaTen, new { @class = "form-control", @readonly = true })
                        </td>
                    </tr>

                }
                <tr>
                    <td style="width: 15%" class="tdtitle">Mã nhân viên công tác</td>
                    <td style="width: 35%">@Html.TextBoxFor(model => model.NhanVien.maNhanVien, new { @class = "form-control", @readonly = true, required = "required" })</td>
                    <td style="width: 15%" class="tdtitle">Tên nhân viên công tác</td>
                    <td style="width: 35%">

                        @if ((string)ViewBag.AdminNhanSu == "true")
                        {
                            @Html.TextBoxFor(model => model.NhanVien.hoVaTen, new { @class = "form-control", @readonly = true, @style = "width:86%;float:left;margin-right: 5px;" })
                            <button class="btn btn-info" id="ChooseNV" type="button">.....</button>
                            @Html.Hidden("nhanVienNhanSu", (string)ViewBag.AdminNhanSu)
                        }
                        else
                        {
                            @Html.TextBoxFor(model => model.NhanVien.hoVaTen, new { @class = "form-control", @readonly = true })
                            @Html.Hidden("nhanVienNhanSu", (string)ViewBag.AdminNhanSu)
                        }
                    </td>
                </tr>
                <tr>
                    <td class="tdtitle">Số phiếu ĐK công tác </td>
                    <td>@Html.TextBoxFor(model => model.maPhieu, new { @class = "form-control", @readonly = true })</td>
                    <td class="tdtitle">Phòng ban đến công tác </td>
                    <td>@Html.TextBoxFor(model => model.tenPhongBan, new { @class = "form-control", @readonly = true, @Style = "width:80%;  margin-right: 5px;   float: left;" })
                        <button class="btn btn-info" id="ChoosePB" type="button">Chọn</button>
                        @Html.HiddenFor(model => model.phongBanCongTac)
                    </td>
                    @*<td>Loại công tác</td>
                    <td>
                        @Html.RadioButtonFor(model => model.loaiCongTac, false, new { @id = "rad-1", @style = "width:auto",@checked=true }) Trong nước @Html.RadioButtonFor(model => model.loaiCongTac, true, new { @id = "rad-2", style = "width:auto" }) Nước ngoài

                    </td>*@
                </tr>
                <tr>
                    <td class="tdtitle"></td>
                    <td class="errorCheckbox">
                        <label class="checkbox-inline" style="padding-top: 0px; font-size: 13px; float: left;">@Html.CheckBoxFor(model => model.congTacNgoai, new { style = "width:auto" }) Công tác ngoài
                        </label>
                        <label class="checkbox-inline" style="padding-top: 0px; font-size: 13px; float: left; display: inline; margin: 0px; padding: 0px;">@Html.CheckBoxFor(model => model.nghiBuTheoGio, new { style = "width:auto", @checked = "" }) Nghỉ bù(Nghỉ theo giờ)
                        </label>
                    </td>
                    <td class="tdtitle nghiTheoNgay">Nơi đến công tác</td>
                    <td  class="nghiTheoNgay">
                        @Html.TextBoxFor(model => model.noiDenCongTacNgoai, new { @class = "form-control" })

                    </td>
                </tr>
                <tr>
                    <td class="tdtitle">Ngày bắt đầu</td>
                    <td>@Html.TextBoxFor(model => model.ngayBatDau, "{0: dd/MM/yyyy}", new { @class = "form-control datepicker" })</td>
                    <td class="tdtitle">Ngày kết thúc</td>
                    <td>@Html.TextBoxFor(model => model.ngayKetThuc, "{0: dd/MM/yyyy}", new { @class = "form-control datepicker" })</td>
                </tr>
                <tr>
                    <td class="tdtitle">Giờ bắt đầu</td>
                    <td>@Html.TextBoxFor(model => model.gioBatDau, new { @class = "form-control", required = "required" })</td>
                    <td class="tdtitle">Giờ kết thúc</td>
                    <td>@Html.TextBoxFor(model => model.gioKetThuc, new { @class = "form-control", required = "required" })</td>
                </tr>

                <tr class="nghiTheoNgay">
                    <td class="tdtitle">Số ngày công tác</td>
                    <td>@Html.TextBoxFor(model => model.soNgayCongTac, new { @class = "form-control numberinput", data_v_max = "999", @readonly = "True" })</td>

                    @*<td>Nơi công tác</td>
                    <td>@Html.DropDownListFor(model => model.maTinh, ViewBag.TinhThanh as SelectList, new { @class = "form-control" })
                        @Html.DropDownListFor(model => model.maQuocGia, ViewBag.QuocGia as SelectList, new { @class = "form-control", @style = "display:none" })

                    </td>*@
                    <td class="tdtitle"  style="display:none">Phụ cấp công tác</td>
                    <td  style="display:none">@Html.TextBoxFor(model => model.phuCap, new { @class = "form-control numberinputInt" })</td>
                </tr>
                <tr style="display: none" class="nghiTheoGio">
                    <td class="tdtitle nghiTheoGio">Số giờ nghỉ bù</td>
                    <td class="nghiTheoGio">@Html.TextBoxFor(model => model.soGioNghiBu, new { @class = "form-control", @readonly = "readonly" })

                    </td>
                </tr>
                <tr style="display: none" class="nghiTheoGio">
                    <td class="tdtitle">Số giờ còn lại nghỉ bù</td>
                    <td>
                        <input class="form-control" id="soGioConLaiNghiBu" readonly="True" type="text" value="0"></td>
                    <td class="tdtitle">Tổng giờ tăng ca:</td>
                    <td>
                        <input class="form-control" id="tongGioTangCa" readonly="True" type="text" value="0">
                    </td>



                </tr>
                <tr>
                    <td class="tdtitle">Nội dung công tác</td>
                    <td colspan="3">
                        @* <div id="editor"></div>
                        @Html.HiddenFor(model => model.ghiChu, new { @class = "form-control" })*@
                        @Html.TextAreaFor(model => model.ghiChu, new { @class = "form-control" })
