<script>
    jQuery(document).ready(function ($) {

        $('#gioBatDau').timepicker({
            showAnim: 'blind'


        });

        $('#gioKetThuc').timepicker({
            showAnim: 'blind'
        });
        $("#gioKetThuc").change(function () {
            if ($("#nghiBuTheoGio").is(":checked")) {
                checkEndTime();
            }
        });

        $("#gioBatDau").change(function () {
            if ($("#nghiBuTheoGio").is(":checked")) {
                checkEndTime();
            }
        });

    });

</script>

