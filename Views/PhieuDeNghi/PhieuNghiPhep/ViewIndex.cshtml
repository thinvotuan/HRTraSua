@using BatDongSan.Models.PhieuDeNghi;
@model IPagedList<sp_NS_PhieuDangKyNghiPhep_IndexResult>
@{
    int i = 1;
    int page_ = Convert.ToInt32(ViewBag.page);
    int total_ = Convert.ToInt32(ViewBag.total);
}
<style>
    .listNghiPhep
    {
    }

        .listNghiPhep li
        {
            display: block;
            line-height: 1.7;
            clear: both;
            float: none;
        }

            .listNghiPhep li span
            {
                float: left;
            }

                .listNghiPhep li span:nth-child(1)
                {
                    color: green;
                    min-width: 50px;
                }
    .formatTable table
    {
        max-width:100% !important;
    }
</style>
<table class="table table-striped table-hover table-condensed TableMobile TablePhieuNghiPhep" id="maintable">
                <thead>
                    <tr>
                        <th style="width: 40px">STT</th>
                        <th style="width: 150px">Số phiếu</th>
                        <th style="width: 150px">Họ và tên</th>
                        <th style="min-width: 200px;">Phòng ban</th>
                        <th style="max-width: 350px;">Loại nghỉ</th>
                        <th style="width: 150px">Ngày nghỉ</th>
                        <th style="width: 100px">Trạng thái</th>
                        <th style="width: 100px"></th>
                    </tr>
                </thead>
                <tbody>
@{
    BatDongSan.Models.HeThong.Sys_User user1 = new BatDongSan.Models.HeThong.Sys_User();
    if (Session["User"] != null)
    {
        user1 = (BatDongSan.Models.HeThong.Sys_User)Session["User"];
    }
}


        @{
              var ls = ViewData["lsDanhSach"] as List<sp_NS_PhieuDangKyNghiPhep_IndexResult>;

    foreach (var item in ls.ToList())
    {
                
            <tr>
                <td style="text-align: center">@i</td>
                <td>
                    <i class="fa fa-clipboard"></i><a style="color:blue" href="@Url.Action("Details", "PhieuNghiPhep", new { id = item.maPhieu })">@item.maPhieu</a><br />
                    <i class="fa fa-calendar" aria-hidden="true"></i>@String.Format("{0: dd/MM/yyyy}", item.ngaylap)
                </td>
                <td>
                    <i class="fa fa-user"></i>@item.hoTen<br />
                    <i class="fa fa-credit-card" aria-hidden="true"></i>@item.maNhanVien
                </td>
                <td>@item.tenPhongBan
                    <br />
                    <i class="fa fa-ticket" aria-hidden="true"></i>@item.TenChucDanh
                </td>
                <td>
                    <div style="max-width: 350px; clear: both; float: none; text-align: left">
                        <ul class="listNghiPhep">
                            <li>
                                @item.tenLoaiNghiPhep
                            </li>
                            <li>
                                <span>Số ngày:</span><span>@String.Format("{0:##,0.#}", item.soNgayNghiPhepThucTe)</span>
                            </li>
                            <li class="formatTable">@Html.Raw(item.lyDo)</li>
                        </ul>

                    </div>
                </td>

                <td>
                    <i class="fa fa-calendar-o" aria-hidden="true"></i>Fr: @String.Format("{0: dd/MM/yyyy}", @item.ngayBatDau)
                    <br />
                    <i class="fa fa-calendar" aria-hidden="true"></i>To: @String.Format("{0: dd/MM/yyyy}", @item.ngayKetThuc)

                </td>
                <td style="text-align: center">
                    <a href="javascript:void(0);" onclick="ViewDetailHistory('@item.maPhieu','@item.maQuiTrinhDuyet')">
                        @item.tenTrangThaiDuyet</a>
                </td>
                <td style="text-align: center">
                    @if ((item.trangThai == 0 && item.nguoiLap == user1.manv) || ((string)ViewBag.Administrator == "true" || (string)ViewBag.AdminNhanSu == "true"))
                    {
                        <a href="@Url.Action("Edit", "PhieuNghiPhep", new { id = item.maPhieu })" title ="Sửa phiếu"><i class="fa fa-pencil-square-o" style="font-size: 30px; color: orange;" aria-hidden="true">| </i></a>                         
                        <a class="btnDelete" alt="@item.maPhieu" title ="Xoá phiếu"><i class="fa fa-trash" style="font-size: 30px; color: red; cursor: pointer;" aria-hidden="true"></i></a>                            
                    }

                </td>
            </tr> 
                    i++;
                }
            
            }
<tr>
    <td colspan="10" align="left" class="clrBeforeMobile">
        @{
                
            if (page_ > 1)
            {
        
            <a class="pageFirst" href="javascript:void(0)" onclick="javascript:OnCriteriaPC(1);">First</a> <a class="pagePrevious" href="javascript:void(0)" onclick="javascript:OnCriteriaPC(@(page_ - 1));">
                Previous</a>
       
            }


            if (page_ - 2 >= 1)
            { 
            <a class="pageCurrent" href="javascript:void(0)" onclick="javascript:OnCriteriaPC(@(page_ - 2));">
                @(page_ - 2) </a> <a class="pageCurrent" href="javascript:void(0)" onclick="javascript:OnCriteriaPC(@(page_ - 1));">
                    @(page_ - 1) </a>
            } <span class="pageActive">@page_</span>
            if (page_ + 2 <= total_)
            { 
            <a class="pageCurrent" href="javascript:void(0)" onclick="javascript:OnCriteriaPC(@(page_ + 1) );">
                @(page_ + 1) </a> <a class="pageCurrent" href="javascript:void(0)" onclick="javascript:OnCriteriaPC(@(page_ + 2));">
                    @(page_ + 2) </a>
            }

            if (page_ < total_)
            { 
        
            <a class="pageNext" href="javascript:void(0)" onclick="javascript:OnCriteriaPC(@(page_ + 1));">Next</a> <a class="pageLast" href="javascript:void(0)" onclick="javascript:OnCriteriaPC(@total_);">
                Last</a>
        
            }
        
            <span class="clrFullMobile"><span>Tổng số dòng :</span><strong>@ViewBag.totalRow</strong></span>
        }
    </td>
</tr>
                    </tbody>
    </table>