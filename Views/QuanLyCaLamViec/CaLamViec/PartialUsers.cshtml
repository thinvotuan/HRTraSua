@using BatDongSan.Models.HeThong;
@model IPagedList<sp_Sys_User_IndexResult>
@{    
    int i = 1;
    string[] parameters = TempData["Params"].ToString().Split(',');
}

<div id="content">
    <table class="table table-striped table-hover table-condensed" id="container">
        <thead>
            <tr>
                <th>STT</th>
                <th>Mã nhân viên</th>
                <th>Họ và tên</th>
                <th>Tên đăng nhập</th>
                <th>Số điện thoại</th>
                <th>
                    <input type="checkbox" name="check-all" id="check-all"></th>
            </tr>
        </thead>
        @foreach (var item in Model)
        {          
            <tr>
                <td class="sothutu">@i
                    <input name="sttMaHieu" type="hidden" value="@i">
                    @Html.Hidden("maNhanVienPopUp", item.manv)
                    @Html.Hidden("tenNhanVienPopUp", item.HovaTen)
                    @Html.Hidden("tenChucDanhPopUp", item.TenChucDanh)
                </td>
                <td>@item.manv
                    <input type="hidden" name="userId" value="@item.userId"/>
                </td>
                <td>
                    <i class="fa fa-user" aria-hidden="true" style="color: #519ee5"></i>&nbsp;@item.HovaTen
                </td>
                <td>
                    <i class="fa fa-envelope-o" aria-hidden="true"></i>&nbsp;@item.userName<br />
                </td>
                <td><i class="fa fa-phone-square" aria-hidden="true"></i>&nbsp;@item.telephone</td>
                <td>
                    <input type="checkbox" name="ChekChonSPK" class="sanphamcb" value="@item.userId"/></td>
            </tr>
            i++;
        }
    </table>
    <div>
        Trang @Model.PageNumber của @Model.PageCount / @ViewBag.Count
    </div>
    <div id="paper">
        <ul class="pagination">
            @Html.Raw(Ajax.Pager(new AjaxOptions { UpdateTargetId = "content", OnBegin = "beginPaging", OnSuccess = "successPaging", OnFailure = "failurePaging" },
                            Model.PageSize, Model.PageNumber, Model.TotalItemCount,
                            new
                            {
                                controller = "CaLamViec",
                                action = "GetMoreUsers",
                                nhomUser = parameters[0],
                                searchString = parameters[1]
                            }))
        </ul>
    </div>
</div>
