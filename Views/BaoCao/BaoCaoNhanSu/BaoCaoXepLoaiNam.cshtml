                    </tr>
                    <tr>
                        <th>Điểm CT</th>
                        <th>Điểm NC	</th>
                        <th>Điểm CD</th>

                        <th>Tổng điểm</th>
                        <th>Điểm CT</th>
                        <th>Điểm NC	</th>
                        <th>Điểm CD</th>

                        <th>Tổng điểm</th>

                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="13" style="text-align: center; padding: 0px !important;">
                            <div id="progress" style="display: none; text-align: center; position: fixed; top: 50%; left: 55%">
                                <img src="../../../Content/images/loading.gif" />
                            </div>
                    </tr>
                    </td>
                </tbody>
                <tbody id="contentTimeLine">
                </tbody>
            </table>
       
</fieldset>
