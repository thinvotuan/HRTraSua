                    </td>
                    <td class="contentNDGNew">
                        @*<select id="maNhomDanhGiaCTHidden">
                            <option value="">--Chọn nhóm đánh giá--</option>
                            @{
                                var listNDGChiTietNew = ViewBag.ListNhomDanhGiasNews as List<BatDongSan.Models.DanhMuc.sp_DG_XepLoaiHangResult>;
                                if (listNDGChiTietNew != null)
                                {
                                    foreach (var itemNhomDGCT in listNDGChiTietNew)
                                    {
                                <option value="@itemNhomDGCT.maNhomDanhGia">@itemNhomDGCT.tenNhomDanhGia</option>
                                    }
                                }
                            }
                        </select>*@
                    </td>
                    <td>


                        <div class="input-group" style="width: 300px; float: right;">
