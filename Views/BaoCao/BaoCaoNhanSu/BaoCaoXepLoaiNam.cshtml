<style>
    #content td, th
    {
        border-bottom: 1px inset #ADC2D6;
        position: relative;
        text-align: center;
    }

    #navigation1
    {
        overflow: auto;
        height: 600px;
    }

    .leftSpan span
    {
        float: left;
        padding-right: 5px;
    }

    .pageActive, .pageCurrent:hover, .pageNext:hover, .pageLast:hover, .pageFirst:hover, .pagePrevious:hover
    {
        padding: 7px 11px;
        background-color: #4D8AFF;
        color: #FFFFFF;
        display: inline-block;
        border: 1px solid #80ABFF;
        border-radius: 20px;
        text-decoration: none;
        font-weight: bold;
    }

    .pageCurrent, .pageNext, .pageLast, .pageFirst, .pagePrevious
    {
        padding: 7px 11px;
        background-color: #fff;
        display: inline-block;
        border: 1px solid #80ABFF;
        border-radius: 20px;
        font-weight: bold;
    }

    .dropdown-menu
    {
        min-width: 420px;
    }

    #grdDanhMucCongViec a.makeLink
    {
        color: red;
    }

    .infor_MucLuongThuong, .infor_TiLe, .infor_tiLeKhenThuongTheoXephang, .infor_TongTiLeCty
    {
        padding: 5px;
        background: rgb(226, 144, 72);
        border-radius: 3px;
        color: #fff;
        box-sizing: border-box;
        margin: 5px auto;
        line-height: 1.7;
    }

    .removeBorderFieldset .table th, .removeBorderFieldset .tableThemeCustome th
    {
        font-size: 12px !important;
        font-weight: normal !important;
    }

    .clicked
    {
        background-color: rgba(245, 245, 93, 0.25);
    }

   
    input[name='tilephantram'], input[name='tiLe']
    {
        background: url("../Images/percent.png") no-repeat;
        background-position: right center;
        background-color: #fff;
        padding-right: 14px !important;
        background-size: 20px;
    }
</style>
<script type="text/javascript">
    var sttIndex = 0;
    var termMaNhomDG = 0;
    $(document).ready(function () {
        $(".showTongNV").html($("#TongSoNVCty").val());
    });




</script>


<!--Scroll Load Page-->
<script type="text/javascript">
    var countParent = 0;
    var parent = "parent0";
    var flashIndex = 0, ngayQuery = 0,
 isPreviousEventComplete = true,
 isDataAvailable = true;
    var flashNgay = 0;
    var ngayCurr = "";
    var sttClick = 0;
    var ngayHienTai = "";
    var sIndex = 0, offSet = 39, limit = 40;
    var myArray = { "Chọn loại": "0", "Xuất sắc": "XS", "Loại A+": "A+", "Loại A": "A", "Loại B+": "B+", "Loại B": "B", "Loại C": "C" };
    $(document).ready(function () {
        
        $("#qSearchCTNV").keyup(function (e) {

            if (event.keyCode == 13) {
                $('#btnSearchCTNV').click();
            }
        });








        $("#contentTimeLine").html('');
        //btnRefreshTL//
        $("#btnSearchCTNV").click(function () {
            
            flashIndex = 0;
            sIndex = 0;
            offSet = 39;
            sttIndex = 0;
            $("#currentDateTL").val('');
            $("#contentTimeLine").html("");
            $("#progress").show();

            isPreviousEventComplete = true;
            isDataAvailable = true;

            getData();



        });
        $("#namCTNV").change(function () {
            listNhomDanhGia($("#namCTNV").val());
            $("#btnSearchCTNV").click();
            


        });
        $(document).on("change", "#maNhomDanhGiaCTHidden,.sltLoai", function () {
            flashIndex = 0;
            sIndex = 0;
            offSet = 39;
            sttIndex = 0;
            $("#currentDateTL").val('');
            $("#contentTimeLine").html("");
            $("#progress").show();

            isPreviousEventComplete = true;
            isDataAvailable = true;
            getData();
        });



        //End btnRefreshTL//
        //-------------------------------------------------------





        $("#progress").show();

        isPreviousEventComplete = true;
        isDataAvailable = true;
        listNhomDanhGia($("#namCTNV").val());
        getData();

        if ($('#back-to-top').length) {
            var scrollTrigger = 100, // px
                backToTop = function () {
                    var scrollTop = $(window).scrollTop();
                    if (scrollTop > scrollTrigger) {
                        $('#back-to-top').addClass('show');
                    } else {
                        $('#back-to-top').removeClass('show');
                    }
                };
            backToTop();
            $(window).bind('scroll', function () {
                backToTop();
            });
            $('#back-to-top').bind('click', function (e) {
                e.preventDefault();
                $('html,body').animate({
                    scrollTop: 0
                }, 700);
            });
        }
    });
    var loading = false,
        noRecordToGet = false;

    $(window).scroll(function () {

        if (flashIndex != 0) {
            if ($(document).height() - 50 <= $(window).scrollTop() + $(window).height()) {



                if (isPreviousEventComplete && isDataAvailable) {

                    isPreviousEventComplete = false;

                    $("#progress").show();

                    getData();
                }


            }
        }
    });
    function enterToSeacrh(event) {
        if (event.keyCode == 13)
            $("#btnSearchCTNV").click();
    }
    function listNhomDanhGia(nam) {
        
        $.ajax({
            type: "POST",
            url: "@Url.Action("ListNhomDanhGia", "BaoCaoNhanSu")" + "?nam=" + nam,

            success: function (result) {
                
                var html = '';
                html += '<select id="maNhomDanhGiaCTHidden">';
                html += '<option value="">-- Chọn nhóm đánh giá--</option>';
                if (result.lists != null) {
                    for (var i = 0; i < result.lists.length; i++) {



                        html += '<option value="' + result.lists[i].maPhongBan + '">' + result.lists[i].maPhongBan + '</option>';




                    }
                }
                html += '</select>';
                $(".contentNDGNew").html(html);
            }
        });
    }
    function getData() {

        var qSearchCTNV = $("#qSearchCTNV").val();
        // replace(/ /gi, '+')

        $.ajax({
            type: "POST",
            url: "@Url.Action("LoadBaoCaoChiTietNhanVienPB", "BaoCaoNhanSu")",
            data: {
                maNhomPhongBan: $(".contentSel .sltLoai").val(),
                nam: $("#namCTNV").val(),
                maNhomDanhGia: $("#maNhomDanhGiaCTHidden").val(),
                qSearch: qSearchCTNV,
                pageIndex: sIndex,
                pageSize: offSet
            },
            success: function (result) {
                
                if (result.lists != null && result.lists != "") {
                    var select = $('.contentSel').html();
                    var html = '';

                    for (var i = 0; i < result.lists.length; i++) {
                        sttIndex++;
                        var clsMauLoai = '';
                        if (result.lists[i].xepLoaiHT == 'XS') { clsMauLoai = 'Color_XS' }
                        if (result.lists[i].xepLoaiHT == 'A+') { clsMauLoai = 'Color_AA' }
                        if (result.lists[i].xepLoaiHT == 'A') { clsMauLoai = 'Color_A' }

                        if (result.lists[i].xepLoaiHT == 'B+') { clsMauLoai = 'Color_BB' }
                        if (result.lists[i].xepLoaiHT == 'B') { clsMauLoai = 'Color_B' }
                        if (result.lists[i].xepLoaiHT == 'C') { clsMauLoai = 'Color_C' }
                        var clsMauLoaiHT = '';
                        if (result.lists[i].dieuChinhXL == 'XS') { clsMauLoaiHT = 'Color_XS' }
                        if (result.lists[i].dieuChinhXL == 'A+') { clsMauLoaiHT = 'Color_AA' }
                        if (result.lists[i].dieuChinhXL == 'A') { clsMauLoaiHT = 'Color_A' }

                        if (result.lists[i].dieuChinhXL == 'B+') { clsMauLoaiHT = 'Color_BB' }
                        if (result.lists[i].dieuChinhXL == 'B') { clsMauLoaiHT = 'Color_B' }
                        if (result.lists[i].dieuChinhXL == 'C') { clsMauLoaiHT = 'Color_C' }
                        html += '<tr>';
                        html += '<td style="text-align:right">' + sttIndex + '</td>';
                        html += '<td>' + result.lists[i].tenPhongBan + '</td>';
                        html += '<td>' + result.lists[i].hoTen + '</td>';
                        //html += '<td>' + result.lists[i].tenChucVu + '</td>';
                        html += '<td style="text-align:right">' + result.lists[i].diemCT1 + '</td>';
                        html += '<td style="text-align:right">' + result.lists[i].diemNC1 + '</td>';
                        html += '<td style="text-align:right">' + result.lists[i].diemCD1 + '</td>';
                        html += '<td style="text-align:right;background: #f5f55d;">' + result.lists[i].tongDiem1 + '</td>';
                        html += '<td style="text-align:right">' + result.lists[i].diemCT2 + '</td>';
                        html += '<td style="text-align:right">' + result.lists[i].diemNC2 + '</td>';
                        html += '<td style="text-align:right">' + result.lists[i].diemCD2 + '</td>';
                        html += '<td style="text-align:right;background: #f5f55d;">' + result.lists[i].tongDiem2 + '</td>';
                        html += '<td style="text-align:right;background: #dfd;">' + result.lists[i].tongDiem + '</td>';
                        html += '<td style="text-align:center" class="' + clsMauLoaiHT + '">' + result.lists[i].dieuChinhXL + '</td>';


                       



                        html += '</tr>';

                    }


                }
               
                $("#contentTimeLine").append(html);
                flashIndex = 1;

                sIndex = sIndex + limit;
                offSet = offSet + limit;

                isPreviousEventComplete = true;

                if (result.lists == '')  //When data is not available
                    isDataAvailable = false;
                $("#progress").hide();

            },
            error: function (error) {
                $("#progress").hide();
            }
        });
    }

</script>
<!-- End Scroll load page -->
