@using BatDongSan.Models.NhanSu
@using BatDongSan.Models.NhanSu
@{
    ViewBag.Title = "Index";
    Layout = null;
    int stt = 1;
    var lstThangMuoi = ViewBag.lstThangMuoi as List<tbl_NS_NhanVien_Thuong>;
}
@{
    foreach (var item in lstThangMuoi){                             
   
    <tr>
        <td align="center">
            @(stt++)
        </td>

        <td>@item.maNhanVien<br />
            <i class="fa fa-user" aria-hidden="true"></i>@item.tenNhanVien</td>
        <td style="text-align: right">@String.Format("{0:###,##0.00}", item.motThangLuong)</td>
        <td style="text-align: right">@String.Format("{0:###,##0.00}", item.thuong17Trieu)</td>
        <td style="text-align: right">@String.Format("{0:###,##0.00}", item.diemKPI)</td>
        <td style="text-align: right">@String.Format("{0:###,##0.00}", item.thuongKPI)</td>
        <td style="text-align: right">@String.Format("{0:###,##0.00}", item.tong)</td>
        <td style="text-align: right">@String.Format("{0:###,##0.00}", item.thueTNCN)</td>
        <td style="text-align: right">@String.Format("{0:###,##0.00}", item.thue10)</td>
        <td style="text-align: right">@String.Format("{0:###,##0.00}", item.thucNhan)</td>
        <td style="text-align: right">@String.Format("{0:###,##0.00}", item.chuyenDot1)</td>
        <td style="text-align: right">@String.Format("{0:###,##0.00}", item.chuyenDot2)</td>
    </tr>
}}
<tr class="sumTong">
    <td align="center" colspan="2">Tổng
    </td>
    <td style="text-align: right">@String.Format("{0:###,##0}", lstThangMuoi.Sum(d=>d.motThangLuong))</td>
    <td style="text-align: right">@String.Format("{0:###,##0.00}", lstThangMuoi.Sum(d=>d.thuong17Trieu))</td>
    <td style="text-align: right">@String.Format("{0:###,##0.00}", lstThangMuoi.Average(d=>d.diemKPI))</td>
    <td style="text-align: right">@String.Format("{0:###,##0.00}", lstThangMuoi.Sum(d=>d.thuongKPI))</td>
    <td style="text-align: right">@String.Format("{0:###,##0.00}", lstThangMuoi.Sum(d=>d.tong))</td>
    <td style="text-align: right">@String.Format("{0:###,##0.00}", lstThangMuoi.Sum(d=>d.thueTNCN))</td>
    <td style="text-align: right">@String.Format("{0:###,##0.00}", lstThangMuoi.Sum(d=>d.thue10))</td>
    <td style="text-align: right">@String.Format("{0:###,##0.00}", lstThangMuoi.Sum(d=>d.thucNhan))</td>
    <td style="text-align: right">@String.Format("{0:###,##0.00}", lstThangMuoi.Sum(d=>d.chuyenDot1??0))</td>
    <td style="text-align: right">@String.Format("{0:###,##0.00}", lstThangMuoi.Sum(d=>d.chuyenDot2??0))</td>

</tr>
