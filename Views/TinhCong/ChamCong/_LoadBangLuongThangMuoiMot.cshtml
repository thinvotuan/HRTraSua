@using BatDongSan.Models.NhanSu
@{
    ViewBag.Title = "Index";
    Layout = null;
    int stt = 1;
    var lstThangMuoi = ViewBag.lstThangMuoi as List<tbl_NS_NhanVien_Thuong11>;
}
@{
    foreach (var item in lstThangMuoi){                             
   
    <tr>
        <td align="center">
            @(stt++)
        </td>

        <td>@item.maNhanVien<br />
            <i class="fa fa-user" aria-hidden="true"></i>@item.tenNhanVien</td>
        <td>@item.TaiKhoan</td>
        <td>@item.PhongBan</td>
        <td style="text-align: right">@String.Format("{0:###,##0.00}", item.tongDiem)</td>
        <td style="text-align: right">@String.Format("{0:###,##0.00}", item.luongKPI)</td>
        <td style="text-align: right">@String.Format("{0:###,##0.00}", item.tong)</td>
        <td style="text-align: right">@String.Format("{0:###,##0.00}", item.thueLuyTien)</td>
        <td style="text-align: right">@String.Format("{0:###,##0.00}", item.thueMuoi)</td>
        <td style="text-align: right">@String.Format("{0:###,##0.00}", item.thucNhan)</td>
        <td style="text-align: right">@String.Format("{0:###,##0.00}", item.ghiChu)</td>
    </tr>
}}
