@using BatDongSan.Models.NhanSu
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
  
   
}

<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/additional-methods.min.js"></script>
<script src="~/Scripts/autoNumeric.js"></script>
<script src="~/Scripts/batdongsan.validate.js"></script>
<script src="~/Scripts/moment.min.js"></script>
<script src="~/Scripts/vi.js"></script>
<script src="~/Scripts/bootstrap-datetimepicker.min.js"></script>
<link rel="stylesheet" href="~/Content/bootstrap-datetimepicker.min.css" />
<script src="~/Scripts/jquery.unobtrusive-ajax.min.js"></script>
<style>
    .pageActive, .pageCurrent:hover, .pageNext:hover, .pageLast:hover, .pageFirst:hover, .pagePrevious:hover {
        padding: 7px 11px;
        background-color: #4D8AFF;
        color: #FFFFFF;
        display: inline-block;
        border: 1px solid #80ABFF;
        border-radius: 20px;
        text-decoration: none;
        font-weight: bold;
    }

    .pageCurrent, .pageNext, .pageLast, .pageFirst, .pagePrevious {
        padding: 7px 11px;
        background-color: #fff;
        display: inline-block;
        border: 1px solid #80ABFF;
        border-radius: 20px;
        font-weight: bold;
    }
</style>
<script type="text/javascript">
    $(document).ready(function () {
        $(".datepicker").datetimepicker({
            locale: 'vi',
            format: 'DD/MM/YYYY'
        });
        $("#btnSearch").click(function () {
            Search();
        });
        $("#nam,#thang").change(function () {
            $("#btnSearch").click();
        });
        Search();



    });
    function OnCriteriaPC(page) {
        var giatri = $("#qSearch").val().trim();
        giatri = giatri.replace(/ /gi, '+');
        var url = '@Url.Action("LoadXemTinhHinhRaVao", "ChamCong")' + "?thang=" + $("#thang").val() + "&nam=" + $("#nam").val() + "&qSearch=" + giatri + "&_page=" + page;
        var imageUrl = '<div id="divMsg" align="center"><img src="@Url.Content("~/Content/Images/loading.gif") "/></div>';
        $('#tbody').html(imageUrl);
        $('#tbody').load(url, function () {
        });
    }

    function Search() {

        var giatri = $("#qSearch").val().trim();
        giatri = giatri.replace(/ /gi, '+');
        var url = '@Url.Action("LoadXemTinhHinhRaVao", "ChamCong")' + "?thang=" + $("#thang").val() + "&nam=" + $("#nam").val() + "&qSearch=" + giatri + "&_page=0";

        var imageUrl = '<div id="divMsg" align="center"><img src="@Url.Content("~/Content/Images/loading.gif") "/></div>';
        $('#tbody').html(imageUrl);
        $('#tbody').load(url, function () {
        });
    }


    function Reset() {
        location.href = '@Url.Action("XemTinhHinhRaVao", "ChamCong")';
    }


    function enterToSeacrh(event) {
        if (event.keyCode == 13)
            $("#btnSearch").click();
    }

    function ProgressXuatChiTiet(obj) {
        var giatri = $("#qSearch").val().trim();
        var button = $(obj).clone();
        var xhr = new XMLHttpRequest();
        var thang = $("#thang").val();
        var nam = $("#nam").val();
        var qSearch = giatri;
        xhr.open('POST', "/ChamCong/XuatFileChiTietGioQuet?thang=" + $("#thang").val() + "&nam=" + $("#nam").val() + "&qSearch=" + giatri, true);
        xhr.responseType = 'arraybuffer';
        xhr.onload = function () {
            if (this.status === 200) {
                var filename = "";
                var disposition = xhr.getResponseHeader('Content-Disposition');
                if (disposition && disposition.indexOf('attachment') !== -1) {
                    var filenameRegex = /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/;
                    var matches = filenameRegex.exec(disposition);
                    if (matches != null && matches[1]) filename = matches[1].replace(/['"]/g, '');
                }
                var type = xhr.getResponseHeader('Content-Type');

                var blob = new Blob([this.response], { type: type });
                if (typeof window.navigator.msSaveBlob !== 'undefined') {
                    // IE workaround for "HTML7007: One or more blob URLs were revoked by closing the blob for which they were created. These URLs will no longer resolve as the data backing the URL has been freed."
                    window.navigator.msSaveBlob(blob, filename);
                } else {
                    var URL = window.URL || window.webkitURL;
                    var downloadUrl = URL.createObjectURL(blob);

                    if (filename) {
                        // use HTML5 a[download] attribute to specify filename
                        var a = document.createElement("a");
                        // safari doesn't support this yet
                        if (typeof a.download === 'undefined') {
                            window.location = downloadUrl;
                        } else {
                            a.href = downloadUrl;
                            a.download = filename;
                            document.body.appendChild(a);
                            a.click();
                        }
                    } else {
                        window.location = downloadUrl;
                    }

                    setTimeout(function () { URL.revokeObjectURL(downloadUrl); }, 100); // cleanup
                }

            }
        };
        xhr.onloadstart = function (e) {
            $(obj).prop('disabled', true).html('<img src="/Images/progress.gif" />')
        };
        xhr.onloadend = function (e) {
            $(obj).replaceWith(button);
        };
        xhr.setRequestHeader('Content-type', 'application/x-www-form-urlencoded');
        xhr.send($.param({
            thang: thang,
            nam: nam,
            qSearch: qSearch
        }));
    }


</script>

<fieldset class="removeBorderFieldset">

    <div id="tabs" style="" class="ui-tabs">
        <ul class="ui-tabs-nav">
            <li class="ui-tabs-selected ui-state-active"><a><span>Xem tình hình nhân viên ra vào</span></a></li>
        </ul>
    </div>
    <div id="container">
        <div id="filter-panel" class="collapse filter-panel" style="display: block; position: relative">
            <div class="panel panel-default background_top">
                <div class="panel-body">
                    <div style="line-height: 26px; float: left">
                        Tháng:@Html.DropDownList("thang", ViewData["lstThang"] as SelectList, new { @style = "width:150px" })
                        Năm:@Html.DropDownList("nam", ViewData["lstNam"] as SelectList, new { @style = "width:150px" })



                    </div>
                    <div style="display: inline-flex; width: 350px; float: right" class="clrFullMobile">
                        <input type="text" class="form-control input-sm" style="width: 100%" id="qSearch" value="" placeholder="Nhập giá trị tìm kiếm" onkeypress="enterToSeacrh(event)">

                        <div style="float: right">
                            <button id="btnSearch" type="button" class="btn btn-primary btn-sm" style="border: 1px double; margin-left: 5px">
                                <span class="glyphicon glyphicon-search"></span>Tìm kiếm
                            </button>
                        </div>
                        <div style="float: right">
                            <button class="btn btn-info" type="button" style="float: left; margin-left: 10px !important; min-width: 145px;" onclick="ProgressXuatChiTiet(this)">Xuất file chi tiết giờ quét</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <table style="width: 100%" class="table table-striped table-hover table-condensed tableThemeCustome TableMobile TableXemTinhHinhRaVao">

            <thead>
                <tr>
                    <th style="width: 35px; text-align: center">STT
                    </th>
                    <th style="text-align: center">Nhân viên
                    </th>

                    <th style="text-align: center">Mã Vân tay - Mã chấm công
                    </th>
                    <th style="text-align: center">Tên phòng ban-Chức danh
                    </th>
                    <th style="text-align: center">Ngày quét</th>
                    <th style="text-align: center">Tên ngày</th>
                    <th style="text-align: center">Giờ quét</th>
                    <th style="text-align: center">Tên máy chấm công</th>


                </tr>
            </thead>
            <tbody id="tbody">
            </tbody>


        </table>

    </div>
</fieldset>
