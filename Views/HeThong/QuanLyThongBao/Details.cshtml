<script type="text/javascript">
    $().ready(function () {
        var daGuiEmail = $("#daGuiEmail").val();
        if(daGuiEmail != 1){
            $("#btnGuiEmailBi").click();
        }
      
        //setting phong ban//
        $("#navigation1").treeview({
            persist: "location",
            unique: false,
            collapsed: true
        }).find(".expandable-hitarea").click();
        
        $('ul.dropdown-menu .hitarea').on('click', function (event) {
            event.stopPropagation();
        });
        //
        //Xóa file upload
        $(".btnDeleteFile").click(function () {
            var url = "@Url.Action("DeleteFile", "QuanLyThongBao")" + "/" + this.value;
            var row = $(this).closest("tr");
            $.ajax({
                url: url,
                type: 'POST',
                data: 'json',
                success: function () {
                    row.remove();
                    Alert.success("Đã xóa thành công", "Thông báo", { displayDuration: 2000 });
                },
                error: function () {
                    Alert.error("Có lỗi xảy ra.", "Thông báo", { displayDuration: 2000 });
                }
            })
        });
        //

        $('#txtsearch').on("input", function () {

            $('#phongban-div #navigation1').filterLink($('#phongban-div #txtsearch').val());
        });

        $("#phongban-dropdown-menu").removeAttr("style");

        $("#customModal").on("hide.bs.modal", function () {
            $("#custom-panel").html("");
        });

        $(document).on("click", "#phongban-div #phongban-dropdown-menu li a", function () {
           
            var valMaPB = $("#btnPhongBan").val();
            valMaPB = valMaPB + "__" + $(this).attr('id');
            $("#saveIDPhongBan").val($(this).attr('id'));
            $("#btnPhongBan").val(valMaPB);
            $("#maPhongBan").val($(this).attr('id'));
            var liHTML = "<li attrPB='"+$(this).attr('id')+"'><span class='deletePB'><i class='fa fa-times' aria-hidden='true'></i></span>"+$(this).text()+"</li>";
            $(".GroupPhongBanSeleted ul").append(liHTML);
            $(this).parents(".dropdown").find('.btn').html("Chọn phòng ban");
            var ValPB = "";
            for(var stt = 0; stt <  $(".GroupPhongBanSeleted ul li").length; stt++){
                
                ValPB = ValPB + $(".GroupPhongBanSeleted ul li").eq(stt).attr('attrPB')+",";
            }
            $("#lstPhongBanSeleted").val(ValPB);

        });
        $("#btnSave").click(function () {
            if($("#tenThongBao").val()==null || $("#tenThongBao").val()==""){
                Alert.warning("Vui lòng nhập tên thông báo.", "Thông báo", { displayDuration: 3000 });

                $("#tenThongBao").focus();
                return false;
            }
            if($("#lstPhongBanSeleted").val()==null || $("#lstPhongBanSeleted").val()==""){
                Alert.warning("Vui lòng chọn phòng ban cần thông báo.", "Thông báo", { displayDuration: 3000 });
               
                return false;
            }
            $("form").submit();
             
        });  
        setTimeout(function () { $("#divMsg").hide() }, 5000); 
        $("#btnPhongBan").val();
        $("#ListNhanVien").select2({
            placeholder: "Chọn nhân viên"
        });
        $("#ListCapBac").select2({
            placeholder: "Chọn cấp bậc"
        });
        $(document).on("click",".deletePB",function(){
            $(this).parent().remove();
            var ValPB = "";
            for(var stt = 0; stt <  $(".GroupPhongBanSeleted ul li").length; stt++){
                
                ValPB = ValPB + $(".GroupPhongBanSeleted ul li").eq(stt).attr('attrPB')+",";
            }
            $("#lstPhongBanSeleted").val(ValPB);
        })
        GetGiaTriPB();
    });

    function GetGiaTriPB(){
        var ValPB = "";
        for(var stt = 0; stt <  $(".GroupPhongBanSeleted ul li").length; stt++){
                
            ValPB = ValPB + $(".GroupPhongBanSeleted ul li").eq(stt).attr('attrPB')+",";
        }
        $("#lstPhongBanSeleted").val(ValPB);
    }

    function ValidateKeypress(numcheck, e) {
        var keynum, keychar, numcheck;
        if (window.event) {//IE
            keynum = e.keyCode;
        }
        else if (e.which) {// Netscape/Firefox/Opera
            keynum = e.which;
        }
        if (keynum == 8 || keynum == 127 || keynum == null || keynum == 9 || keynum == 0 || keynum == 13) return true;
        keychar = String.fromCharCode(keynum);
        var result = numcheck.test(keychar);
        return result;
    }   
    
    function GuiEmailThongBao(id)
    {
        bootbox.confirm("Bạn có muốn gửi email đến nhân viên không", function(result){
            if(result)
            {
               
                
             
                $("#btnGuiEmail").hide();
                $(".pageLoading").show();
                var url='@Url.Action("SendEmailThongBao", "QuanLyThongBao")'+'/'+id;
                $.ajax({
                    url:url,
                    type:'POST',
                    data:'json',
                    success: function () {
                        Alert.success("Gửi email thành công", "Thông báo", { displayDuration: 2000 });
                        $(".pageLoading").hide();
                    },
                    error: function () {
                        Alert.success("Gửi email thành công", "Thông báo", { displayDuration: 2000 });
                        $(".pageLoading").hide();
                    }
                })
                    
                
            }
        }
        );
    }
    function GuiEmailThongBaoBi(id)
    {
        
        var url='@Url.Action("SendEmailThongBaoBi", "QuanLyThongBao")'+'/'+id;
        $.ajax({
            url:url,
            type:'POST',
            data:'json',
            success: function () {
                //Alert.success("Gửi email thành công", "Thông báo", { displayDuration: 2000 });
                //$(".pageLoading").hide();
            },
            error: function () {
                // Alert.success("Gửi email thành công", "Thông báo", { displayDuration: 2000 });
                // $(".pageLoading").hide();
            }
        })
                       
    }
  
</script>

