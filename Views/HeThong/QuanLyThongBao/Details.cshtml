<form method="post" id="form-submit" enctype="multipart/form-data">
    <fieldset class="fieldset1">
        <input type="hidden" name="lstPhongBanSeleted" id="lstPhongBanSeleted" />
        <legend class="legend">Xem thông báo</legend>

        <div class="tab-content">
            <div class="tab-pane in active" id="tab1">
                <table border="0" cellpadding="0" cellspacing="0" style="width: 100%;">
                    <tr>
                        <td style="width: 150px" class="tdtitle">Tên
                        </td>
                        <td>
                            <label>@item.tenThongBao</label>
                            <input type="hidden" value="@(item.daGuiEmail == true ? 1 : 0)" name="daGuiEmail" id="daGuiEmail" />
                            <input type="hidden" value="@(item.daGuiSMS == true ? 1 : 0)" name="daGuiSMS" id="daGuiSMS" />
                        </td>
                    </tr>
                    <tr>
                        <td style="width: 150px" class="tdtitle">Title Email
                        </td>
                        <td>
                            <label>@item.titleMail
                            </label>
                        </td>

                    </tr>
                    <tr>
                        <td class="tdtitle">Phòng ban 
                        
                        </td>

                        <td>
                            @*<span style="float: left">
                                <input type="text" readonly="readonly" name="maPhongBan" id="maPhongBan" value="@item.maPhongBan" />
                            </span>*@
                            <span style="float: left">
                                <div class="form-group" id="phongban-div" style="display: none">
                                    <div class="dropdown">
                                        <button class="btn btn-primary btn-sm dropdown-toggle" id="btnPhongBan" type="button" data-toggle="dropdown">
                                            Chọn phòng ban&nbsp;<span class="caret"></span>
                                        </button>
                                        <ul class="dropdown-menu" id="phongban-dropdown-menu">
                                            <li role="presentation">
                                                <div class="form-group has-feedback" style="width: 90%; margin: 5px auto;">
                                                    <input type="text" class="form-control input-sm" id="txtsearch" placeholder="Search" style="width: 100%" />
                                                    <span class="glyphicon glyphicon-search form-control-feedback"></span>
                                                </div>
                                            </li>
                                            <li role="presentation">
                                                @Html.Raw(ViewBag.PhongBans)
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                                <div class="GroupPhongBanSeleted">
                                    <ul>
                                        @{
                                            var lstPB = ViewBag.PBs;
                                            foreach (var itemPB in lstPB)
                                            {
                                            <li attrPB="@itemPB.MaPhongBan"><i class="fa fa-check" aria-hidden="true"></i>@itemPB.Ten</li>
                                            }
                                        }

                                    </ul>
                                </div>
                            </span></td>
                    </tr>
                    <tr>
                        <td class="tdtitle">Cấp bậc</td>
                        <td style="border: 1px solid #ccc !important;">

                            <select class="form-control selectpicker" id="ListCapBac" name="ListCapBac" multiple="multiple" disabled="disabled">

                                @{
                                    if (item.listCapBac != null)
                                    {
                                        var lstCB = item.listCapBac.ToString();
                                        foreach (var itemCD in ViewBag.capBacChucDanh as List<BatDongSan.Models.DanhMuc.tbl_DM_CapBacChucDanh>)
                                        {
                                            if (lstCB.Contains(Convert.ToString(itemCD.soCapBac)))
                                            {
                                    <option value="@itemCD.soCapBac" selected>@itemCD.tenCapBac</option>
                                            }

                                        }
                                    }
                                    
                                }
                            </select>
                        </td>
                    </tr>
                    <tr>
                        <td class="tdtitle">Nhân viên</td>
                        <td style="border: 1px solid #ccc !important;">
                            <select class="form-control selectpicker" id="ListNhanVien" name="ListNhanVien" multiple="multiple" disabled="disabled">
                                @{
                                    if (item.listNhanVien != null)
                                    {
                                        var lstNV = item.listNhanVien.ToString();
                                        foreach (var itemNV in ViewBag.nhanViens as List<tbl_NS_NhanVien>)
                                        {
                                            var hovaten = itemNV.ho + " " + itemNV.ten;
                                            if (lstNV.Contains(Convert.ToString(itemNV.maNhanVien)))
                                            {
                                    <option value="@itemNV.maNhanVien" selected>@hovaten</option>
                                            }

                                        }

                                    }}
                            </select>
                        </td>
                    </tr>
                    <tr>
                        <td class="tdtitle">Nội dung
                        </td>
                        <td>

                            @Html.Raw(item.noiDungThongBao)
                        </td>
                    </tr>

                    <tr style="display: none">
                        <td class="tdtitle">Gửi SMS
                        </td>
                        <td>

                            <textarea id="noiDungSMS" name="noiDungSMS" class="form-control">@item.noiDungSMS</textarea>
                        </td>
                    </tr>
                    <tr>
                        <td class="tdtitle">Đính kèm file
                        </td>
                        <td colspan="4" style="background: transparent; padding: 0px !important;">
                            <div id="dinhkemfile-panel" class="filter-panel">
                                <input type="hidden" id="nguoiUpLoad" value="@Session["TenNhanVien"]">
                                <div id="container">
                                    <table class="table table-stripped removeBackTbl" id="tbl-uploading">
                                        <thead>
                                            <tr>
                                                <th colspan="2">Tên tài liệu</th>
                                                <th>Người upload</th>
                                                <th>Ngày upload</th>
                                                <th style="width: 100px">
                                                    <input type="file" style="height: 30px; display: none" name="fileDinhKems" class="form-control" multiple="multiple" value="">
                                                    <input type="file" style="height: 30px; display: none" name="fileDinhKems" id="input-upload" class="form-control" multiple="multiple" value=""></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var file in Model)
                                            {
                                                <tr>
                                                    <td style="text-align: left">
                                                        <img style="width:32px; height: 32px" src="@file.thumbnailURL"></td>
                                                    <td>@file.originalFileName</td>
                                                    <td>@file.tenNguoiUpLoad</td>
                                                    <td>@file.ngayLap</td>
                                                    <td style="text-align: right">
                                                        <a class="btn btn-link btn-xs" type="button" href="@Url.Action("Download", "QuanLyThongBao", new { id = file.id })" value="@file.id"><i class="fa fa-download" aria-hidden="true"></i></a>

                                                    </td>
                                                </tr> 
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>&nbsp;
                        </td>
                        <td colspan="2">

                            <input type="button" class="btn btn-primary" id="btnGuiEmail" value="Gửi email" onclick="GuiEmailThongBao(@item.id)" style="width:100px;">
                            <input type="button" class="btn btn-primary" id="btnGuiEmailBi" value="Gửi email" onclick="GuiEmailThongBaoBi(@item.id)" style="display:none">
                            <input type="button" class="btn btn-primary btnBlack" value="Trở về" onclick="window.location='@Url.Action("Index", "QuanLyThongBao")    '" />
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </fieldset>
</form>

<div class="modal fade" id="loadingModal" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-body">
                <p>
                    <img src="/Images/loader.gif" />
                </p>
            </div>
        </div>
    </div>
</div>
