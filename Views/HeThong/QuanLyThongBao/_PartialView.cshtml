@using BatDongSan.Models.HeThong;
@using BatDongSan.Models.NhanSu;
@model List<tbl_FileDinhKem>
<script>
    $(".showTotalTB").html(@Session["listThongBao"]);
</script>
@Html.Raw(ViewBag.thongTin)
@{
    if (Model!= null && Model.Count>0){
<div class="groupDinhKem">
    <table class="table table-stripped removeBackTbl" id="tbl-uploading">
        <thead>
            <tr>
                <th colspan="2">Tên tài liệu</th>
                <th>Người upload</th>
                <th>Ngày upload</th>
                <th style="width: 100px">
                    <input type="file" style="height: 30px; display: none" name="fileDinhKems" class="form-control" multiple="multiple" value="">
                    <input type="file" style="height: 30px; display: none" name="fileDinhKems" id="input-upload" class="form-control" multiple="multiple" value=""></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var file in Model)
            {
                <tr>
                    <td style="text-align: left">
                        <img style="width:32px; height: 32px" src="@file.thumbnailURL"></td>
                    <td>@file.originalFileName</td>
                    <td>@file.tenNguoiUpLoad</td>
                    <td>@file.ngayLap</td>
                    <td style="text-align: right">
                        <a class="btn btn-link btn-xs" type="button" href="@Url.Action("Download", "QuanLyThongBao", new { id = file.id })" value="@file.id"><i class="fa fa-download" aria-hidden="true"></i></a>

                    </td>
                </tr> 
            }
        </tbody>
    </table>
</div>
}

}