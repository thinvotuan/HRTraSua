@using BatDongSan.Models.NhanSu;
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var lstTrinhDo = ViewBag.listTrinhDos as List<tbl_NS_CauHinhTrinhDo>;
    var lstNhomCVs = ViewBag.listNhomCVs as List<tbl_NS_CauHinhNhomCV>;
    int i = 0;
}
<link rel="stylesheet" href="~/Content/batdongsan-alert.css" />
<script src="~/Scripts/batdongsan.utils.js"></script>
<script type="text/javascript" src="~/Scripts/Jquery.treeview/jquery.treeview.js"></script>
<link rel="stylesheet" href="~/Scripts/Jquery.treeview/jquery.treeview.css" />
<script src="~/Scripts/jquery.unobtrusive-ajax.min.js"></script>

<script src="/Scripts/autoNumeric.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        $(".numberinput").autoNumeric('init', { mDec: 2, mNum: 3, lZero: 'deny', aSep: ',', aDec: '.', pSign: 's', vMin: '0' });
        $("#btnSaveTrinhDo").click(function () {
            goSubmitTLTrinhDo();
        });
        $("#btnSaveNCV").click(function () {
            goSubmitNhomCV();
        });

        $("#btnAddNVC").click(function () {
            var row = $("#tbl-nhomCV >tbody>tr:first").clone();
            var rowCount = $("#tbl-nhomCV >tbody>tr").length + 1;
            row.find("input").val("");
            row.find("td:eq(0)").html(rowCount);
            row.find("td:last").find("button").addClass("btnXoa");
            $("#tbl-nhomCV >tbody").append(row);

        });

        $(document).on("click", ".btnXoa", function () {
            var rowCount = $("#tbl-nhomCV > tbody>tr").length;
            if (rowCount > 1) {
                $(this).parents("tr")[0].remove();
            }
        })
    });
    // Submit Form
    function goSubmitTLTrinhDo() {
        $("#btnSaveTrinhDo").hide();
        var imageUrl = '<div align="center"><img src="/Content/Images/loading.gif "/></div>';

        $(".infor_TiLeTrinhDo").html(imageUrl).css('display', 'block');

        $.post('@Url.Action("SaveQuanLyTrinhDo")', ($('#frmQuanLyTD').serialize()), function (data) {
            $("#btnSaveTrinhDo").show();

        });





    }
    function goSubmitNhomCV() {
        $("#btnSaveNCV").hide();
        var imageUrl = '<div align="center"><img src="/Content/Images/loading.gif "/></div>';

        $(".infor_NhomCongViec").html(imageUrl).css('display', 'block');

        $.post('@Url.Action("SaveNhomCV")', ($('#frmNhomCongViec').serialize()), function (data) {
            $("#btnSaveNCV").show();

        });





    }


</script>
<style>
    input[name='tiLe']
    {
        background: url(../Images/percent.png) no-repeat;
        background-position: right center;
        background-color: #fff;
        padding-right: 14px !important;
        background-size: 20px;
    }
</style>
<div id="container">
    <fieldset class="removeBorderFieldset">

        <div id="tabs" style="" class="ui-tabs ui-widget ui-widget-content ui-corner-all">
            <ul class="ui-tabs-nav ui-helper-reset ui-helper-clearfix ui-widget-header ui-corner-all">
                <li class="ui-state-default ui-corner-top ui-tabs-selected ui-state-active"><a><span></span>Cấu hình thông tin điều chỉnh lương</a></li>
            </ul>
        </div>

        <div class="box_QuanLyTrinhDo">
            <div class="form-group bs-callout bs-callout-info" style="overflow: hidden; margin-bottom: 1px;">
                <h4 class="col-md-12 tieudeGroup" style="color: #1b809e; margin: 0px;"><b></b>Quản lý trình độ<span style="color: red; font-style: italic"></span></h4>
            </div>
            <div class="content_QuanLyTrinhDo">
                <div class="infor_TiLeTrinhDo" style="display: none"></div>
                <form id="frmQuanLyTD" method="post">
                    <table class="table table-striped table-hover table-condensed">
                        <thead>
                            <tr>
                                <th style="width: 100px">Trình độ</th>
                                @{
                                    if (lstTrinhDo != null && lstTrinhDo.Count > 0)
                                    {
                                        foreach (var itemTieuDETD in lstTrinhDo)
                                        {
                                    <th>@itemTieuDETD.tenTrinhDo</th>
                                        }
                                    }
                                }

                            </tr>
                        </thead>
                        <tbody>
                            @{
                                if (lstTrinhDo != null)
                                {
                          
                       
                                <tr>
                                    <td>Tỉ lệ</td>
                                    @{
                                    foreach (var itemTL in lstTrinhDo)
                                    { 
                                        <td>
                                            <input type="hidden" value="@itemTL.maTrinhDo" name="maTrinhDo">
                                            <input type="hidden" value="@itemTL.tenTrinhDo" name="tenTrinhDo">
                                            <input type="text" value="@itemTL.tiLe" name="tiLe" class="numberinput" style="text-align: right">
                                        </td>
                                    }
                                    }


                                </tr>
                                <tr>
                                    <td>Khởi điểm</td>
                                    @{
                                    foreach (var itemKD in lstTrinhDo)
                                    { 
                                        <td>
                                            <input type="text" value="@itemKD.khoiDiem" name="khoiDiem" class="numberinput" style="text-align: right">
                                        </td>
                                    }
                                    }
                                </tr>

                   
                                }
                    
                            }
                            <tr>
                                <td colspan="6" style="text-align: right;">
                                    <button class="btn btn-info btnAdd" id="btnSaveTrinhDo">Lưu </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </form>
            </div>
        </div>

        <div class="box_NhomCongViec">
            <div class="form-group bs-callout bs-callout-info" style="overflow: hidden; margin-bottom: 1px;">
                <h4 class="col-md-12 tieudeGroup" style="color: #1b809e; margin: 0px;"><b></b>Quản lý nhóm công việc<span style="color: red; font-style: italic"></span></h4>
            </div>
            <div class="content_NhomCongViec">
                <div class="infor_NhomCongViec" style="display: none"></div>
                <form id="frmNhomCongViec" method="post">
                    <table id="tbl-nhomCV" class="table table-striped table-hover table-condensed">
                        <thead>
                            <tr>
                                <th>STT</th>
                                <th>Mã nhóm CV</th>
                                <th>Nhóm công việc</th>
                                <th>Phụ cấp</th>

                                <th>
                                    <button type="button" id="btnAddNVC" class="btn btn-primary btn-xs">
                                        <span class="glyphicon glyphicon-plus"></span>
                                    </button>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                if (lstNhomCVs != null && lstNhomCVs.Count > 0)
                                {
                                    foreach (var item in lstNhomCVs)
                                    {
                                        i++;
                                <tr>
                                    <td style="text-align: center" class="setSizeSTT">@i</td>
                                    <td>
                                        <input name="maNCV"  class="form-control" value="@item.maNCV"  />
                                    </td>
                                    <td>
                                        <input name="tenNCV"  class="form-control" value="@item.tenNCV"/></td>
                                    <td>
                                        <input name="phuCap" class="form-control numberinput  auto {mDec:3} setSpecialWith" value="@item.phuCap"  style="text-align: right" onfocus='$(this).autoNumeric()'/></td>

                                    <td style="text-align: center">
                                        <button type="button" class="btn btn-warning btn-xs btnXoa"><span class="glyphicon glyphicon-minus"></span></button>
                                    </td>
                                </tr>
                                    }

                                }
                                else
                                {
                                    for (var j = 1; j <= 5; j++)
                                    {
                                <tr>
                                    <td style="text-align: center" class="setSizeSTT">@j</td>
                                    <td>
                                        <input name="maNCV" class="form-control" value="" /></td>
                                    <td>
                                        <input name="tenNCV" class="form-control" value="" /></td>
                                    <td>
                                        <input name="phuCap" class="form-control numberinput  auto {mDec:3} setSpecialWith" value="" style="text-align: right" onfocus='$(this).autoNumeric()'/></td>

                                    <td style="text-align: center">
                                        <button type="button" class="btn btn-warning btn-xs btnXoa"><span class="glyphicon glyphicon-minus"></span></button>
                                    </td>
                                </tr>
                                    }
                                }
                            
                            
                            }

                        </tbody>

                    </table>
                    <div style="width: 100%; text-align: right">
                        <button class="btn btn-info btnAdd" id="btnSaveNCV">Lưu </button>
                    </div>
                </form>
            </div>
        </div>
    </fieldset>
</div>
