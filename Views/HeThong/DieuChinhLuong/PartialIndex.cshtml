@using BatDongSan.Models.NhanSu;
@{
    Layout = null;
    int i = 1;
    int k = 1;
    int j = 1;
    var listNVs = ViewBag.listNV as List<sp_NS_DieuChinhLuongInDexResult>;
}


<script src="/Scripts/autoNumeric.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        $(".numberinput").autoNumeric('init', { mDec: 0, mNum: 3, lZero: 'deny', aSep: ',', aDec: '.', pSign: 's', vMin: '-10000000000', vMax: '10000000000' });

        $('[data-toggle="tooltip"]').tooltip();
        $(".mouseOver2").hover(function () {
            $(".Img1").remove();

            var valImg = $(this).attr("attsrc");
            $(this).after('<img src="' + valImg + '" class="Img1">');

        });
        $(".valDCL").bind("change", function () {
        
            var maNVUpdate = $(this).parent().parent().attr("id");
            var idHienTai = "#" + maNVUpdate;
            var inpBC = $(idHienTai + " .inpBC").autoNumeric("get");
            var inpNCV = $(idHienTai + " .inpNCV").autoNumeric("get");
            var inpLCV = $(idHienTai + " .inpLCV").autoNumeric("get");
            var inpMTC = $(idHienTai + " .inpMTC").autoNumeric("get");
            var inpLTN = $(idHienTai + " .inpLTN").autoNumeric("get");
            var inpLKN = $(idHienTai + " .inpLKN").autoNumeric("get");
            var inpTH = $(idHienTai + " .inpTH").autoNumeric("get");
            var duyetluongBP = parseFloat(inpBC) + parseFloat(inpNCV) + parseFloat(inpLCV) + parseFloat(inpMTC) + parseFloat(inpLTN) + parseFloat(inpLKN)
            + parseFloat(inpTH);
           
            $(idHienTai + " .inpLuongDuyetBT").autoNumeric("set", duyetluongBP.toFixed(2));

            changeDieuChinh(maNVUpdate, inpLKN, inpTH, duyetluongBP);

        });
        $(".valDCLBTGD").bind("change", function () {
            var maNVUpdate = $(this).parent().parent().attr("id");
            var idHienTai = "#" + maNVUpdate;
            var inpBC = $(idHienTai + " .inpBC").autoNumeric("get");
            var inpNCV = $(idHienTai + " .inpNCV").autoNumeric("get");
            var inpLCV = $(idHienTai + " .inpLCV").autoNumeric("get");
            var inpMTC = $(idHienTai + " .inpMTC").autoNumeric("get");
            var inpLTN = $(idHienTai + " .inpLTN").autoNumeric("get");
            var inpLKN = $(idHienTai + " .inpLKN").autoNumeric("get");
            var inpTH = $(idHienTai + " .inpTH").autoNumeric("get");
            var inpLuongDuyetBT = $(idHienTai + " .inpLuongDuyetBT").autoNumeric("get");
           
            var temp = parseFloat(inpBC) + parseFloat(inpNCV) + parseFloat(inpLCV) + parseFloat(inpMTC) + parseFloat(inpLTN) + parseFloat(inpLKN);
            var inpNewThuHut = parseFloat(inpLuongDuyetBT) - temp;
            $(idHienTai + " .inpTH").autoNumeric("set", inpNewThuHut.toFixed(2));
            changeDieuChinh(maNVUpdate, inpLKN, inpNewThuHut.toFixed(2), inpLuongDuyetBT);
            // changeDieuChinh(idHienTai, giaTriDC);

        });
        $(".inpNhanXet").bind("change", function () {
            var maNVUpdate = $(this).parent().parent().attr("class");
            var yKien = $(this).val();
            changeYKien(maNVUpdate, yKien);
        });
        $(".numberinput").autoNumeric('init', { mDec: 0, mNum: 3, lZero: 'deny', aSep: ',', aDec: '.', pSign: 's', vMin: '0' });
    });

    function changeDieuChinh(maNVUpdate, luongKN, LuongTH, LuongDuyetBTGD) {
        //post
        $.ajax({

            type: "POST",
            url: '/DieuChinhLuong/UpdateDieuChinh',
            dataType: "json",
            data: { maNhanVien: maNVUpdate, luongKN: luongKN, LuongTH: LuongTH, LuongDuyetBTGD: LuongDuyetBTGD },
            success: function (result) {
                Alert.success("Cập nhật điều chỉnh nhân viên: " + maNVUpdate + " thành công", "Thông báo", { displayDuration: 2000 });
                
            },
            error: function () {
                Alert.error("Cập nhật điều chỉnh nhân viên: " + maNVUpdate + "thất bại", "Thông báo", { displayDuration: 2000 });

            }


        });
    }
    function changeYKien(maNVUpdate, yKien) {
        //post
        $.ajax({

            type: "POST",
            url: '/DieuChinhLuong/UpdateYKien',
            dataType: "json",
            data: { maNhanVien: maNVUpdate, yKien: yKien },
            success: function (result) {
                Alert.success("Cập nhật ý kiến đề xuất: " + maNVUpdate + " thành công", "Thông báo", { displayDuration: 2000 });
               
            },
            error: function () {
                Alert.error("Cập nhật ý kiến đề xuất: " + maNVUpdate + "thất bại", "Thông báo", { displayDuration: 2000 });

            }


        });
    }

    function moveScroll() {
        $(".numberinput").autoNumeric('init', { mDec: 0, mNum: 3, lZero: 'deny', aSep: ',', aDec: '.', pSign: 's', vMin: '-10000000000', vMax: '10000000000' });

        var scroll = $(window).scrollTop();
        var anchor_top = $("#maintable").offset().top;
        var anchor_bottom = $("#bottom_anchor").offset().top;
        if (scroll > anchor_top && scroll < anchor_bottom) {
            clone_table = $("#clone");
            if (clone_table.length == 0) {
                clone_table = $("#maintable").clone();
                clone_table.attr('id', 'clone');
                clone_table.css({
                    position: 'fixed',
                    'pointer-events': 'none',
                    top: 0
                });
                clone_table.width($("#maintable").width());
                $("#table-container").append(clone_table);
                $("#clone").css({ visibility: 'hidden' });
                $("#clone thead").css({ 'visibility': 'visible', 'pointer-events': 'auto' });
            }
        } else {
            $("#clone").remove();
        }
    }
    $(window).scroll(moveScroll);
</script>
<style>
    .parentDCLColor
    {
        color: #ec1717;
        font-size: 14px;
        background: #98efd7;
    }

    .colorDeXuat, #container .table th.colorDeXuat, .tableThemeCustome th.colorDeXuat
    {
        background-color: #d0d040 !important;
        color: black !important;
    }

    .tdduyetLuong
    {
        background: #f78585;
    }

    .inpNhanXet
    {
        color: blue !important;
    }
    /*MouseOver*/
    .mouseOver
    {
            display: block;
    position: relative;
    width: 100%;
    text-align: left;
    cursor: pointer;
    background: #ccc;
    }

        .mouseOver img.Img1
        {
            position: absolute;
            transform: translate(-40%);
            bottom: -50px;
            opacity: 0;
            pointer-events: none;
            border-radius: 10px;
            border: 2px solid #bcd475;
            box-sizing: border-box;
            /* animation: borderImgAni 5s linear  infinite alternate; */
            max-width: 250px;
            height: auto;
            z-index: 99999;
            background: #f5ebeb;
            padding: 5px;
        }

        .mouseOver:hover img.Img1
        {
            opacity: 1;
        }
   
</style>
<div class="getGT"></div>

<div id="table-container">
    <table class="table table-striped table-hover table-condensed" id="maintable">
        <thead>
            <tr id="trtop">
                <th rowspan="2"></th>
                <th rowspan="2">Họ tên</th>

                <th rowspan="2">Kết quả đánh giá<br />
                    <span style="font-size: 10px; text-align: center">(2014|2015|2016)</span></th>
                <th rowspan="2" class="clsTongLuongTHTD">Tổng lương 2016<br />
                    (1)</th>
                <th colspan="6" style="background-color: #a27b82 !important;">Cơ cấu lương theo</th>
                <th rowspan="2">Mức tăng chung 5%<br />
                    (8)</th>
                <th rowspan="2">Điều chỉnh lương theo hệ thống<br />
                    (9)</th>
                <th rowspan="2" class="colorDeXuat">Đề xuất lương TBP<br />
                    (10)</th>
                <th rowspan="2">Duyệt lương BTGD<br />
                    (11)</th>
            </tr>
            <tr>
                <th>Bằng cấp<br />
                    (2)</th>
                <th>Nhóm công việc<br />
                    (3)</th>
                <th>Chức vụ<br />
                    (4)</th>
                <th>Kiêm nhiệm<br />
                    (5)</th>

                <th>Thâm niên<br />
                    (6)</th>
                <th>Thu hút<br />
                    (7)</th>
            </tr>
           <tr class="trCongThu">
                <th colspan="14">Công thức: (10) = (2)+(3)+(4)+(5)+(6)+(7)+(8)
                </th>
          </tr>
        </thead>
        <tbody>
            @{
                if (listNVs != null && listNVs.Count > 0)
                {
                    var HSMTBanDau = listNVs[0].maPhongBan;
                    var thuTuParent = 0;
                    var Flash = 0;
                    foreach (var item in listNVs)
                    {
                        if (HSMTBanDau == item.maPhongBan)
                        {
                            Flash = 0;
                        }
                        else
                        {
                            HSMTBanDau = item.maPhongBan;
                            Flash = 1;
                            j = 1;
                        }
                        if (Flash == 1 || thuTuParent == 0)
                        {

                            thuTuParent = 1;
                            Flash = 0;
                <tr>
                    <td class="parentDCLColor">@(i++)</td>
                    <td colspan="13" class="parentDCLColor">
                        <i class="fa fa-bank"></i>@item.tenPhongBan
                    </td>
                </tr>
                            k = (i - 1);
                        }
                        if (Flash == 0)
                        {
                            var clsOther = "";
                            if (item.luongHTMoi != item.luongDCTBP || item.luongHTMoi != item.luongDuyetBTGD)
                            {
                                clsOther = "clsOther";
                            } 
                            var HinhAnh = item.maNhanVien + ".jpg"; 
                <tr id="@item.maNhanVien">
                    <td rowspan="2">@k.@(j++)</td>
                    <td style="min-width: 150px" rowspan="2">
                        <ul>
                            <li style="color: green">
                                <div class="asideImg mouseOver">
                                    <div class="mouseOver2" attsrc="/UploadFiles/QLNV/@HinhAnh">

                                        <i class="fa fa-user" aria-hidden="true"></i>@item.hoTen
                                    </div>
                                </div>
                            </li>

                            <li><span data-toggle="tooltip" title="Bằng cấp">@item.bangCap</span>
                                <br />
                                <span data-toggle="tooltip" title="Ngày vào làm">@String.Format("{0: dd/MM/yyyy}", item.ngayVaoLam)</span> - <span data-toggle="tooltip" title="Thâm niên(tháng)" class="numberinput">@item.thamNien</span>
                            </li>
                        </ul>

                    </td>

                    <td style="text-align: center">@item.ketQuaDanhGia</td>
                    <td style="text-align: right" class="clsTongLuongTHTD numberinput">@item.tongLuong</td>
                    <td style="text-align: right" class="numberinput">@item.luongBangCap

                    </td>
                    <td style="text-align: right" class="numberinput">@item.luongNhomCongViec</td>
                    <td style="text-align: right" class="numberinput">@item.luongChucVu</td>
                    <td style="text-align: right">
                        <input type="hidden" class="form-control inpBC numberinput" style="width: 100%; text-align: right" value="@item.luongBangCap" id="">
                        <input type="hidden" class="form-control inpNCV numberinput" style="width: 100%; text-align: right" value="@item.luongNhomCongViec" id="">
                        <input type="hidden" class="form-control inpLCV numberinput" style="width: 100%; text-align: right" value="@item.luongChucVu" id="">
                        <input type="hidden" class="form-control inpMTC numberinput" style="width: 100%; text-align: right" value="@item.mucTangChung" id="">
                        <input type="hidden" class="form-control inpLTN numberinput" style="width: 100%; text-align: right" value="@item.luongThamNien" id="">
                        <input type="text" class="form-control valDCL inpLKN numberinput" style="width: 100%; text-align: right" value="@item.luongKiemNhiem" id="">
                    </td>
                    <td style="text-align: right" class="numberinput">@item.luongThamNien</td>
                    <td style="text-align: right">
                        <input type="text" class="form-control valDCL inpTH numberinput" style="width: 100%; text-align: right" value="@item.luongThuHut" id="">
                    </td>
                    <td style="text-align: right" class="numberinput">@item.mucTangChung</td>
                    <td style="text-align: right" class="numberinput  @clsOther">@item.luongHTMoi</td>

                    <td class="colorDeXuat" style="text-align: right">
                        <span class="numberinput">@item.luongDCTBP</span>
                        <input type="hidden" class="form-control valDCLTBP inpDeXuatLuong numberinput" style="width: 100%; text-align: right" value="@item.luongDCTBP" id=""></td>

                    <td style="text-align: right" class="tdduyetLuong">
                        <input type="text" class="form-control valDCLBTGD inpLuongDuyetBT numberinput" style="width: 100%; text-align: right" value="@item.luongDuyetBTGD" id=""></td>
                </tr>
                <tr class="@item.maNhanVien">
                    <td colspan="13">
                        <input type="text" placeholder="Ý kiến đề xuất" style="font-style: italic" class="inpNhanXet" value="@item.nhanXet" />
                    </td>
                </tr>
                        }
                    }
                }
            }
            <tr class="trSumTong">
                <td colspan="3" style="text-align: center">Tổng
                </td>
                <td style="text-align:right;" class="numberinput">@ViewBag.sumTLTruocDC</td>
                <td colspan="7"></td>
                 <td style="text-align: right;" class="numberinput">@ViewBag.sumluongHTMoi</td>
                <td style="text-align: right;" class="numberinput">@ViewBag.sumTongDX</td>
                <td style="text-align: right;" class="numberinput">@ViewBag.sumTongDL</td>
            </tr>
        </tbody>
    </table>
    <div id="bottom_anchor"></div>
    <div class="SumTong">
    </div>
</div>
